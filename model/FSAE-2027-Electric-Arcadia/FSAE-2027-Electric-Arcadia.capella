              <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="cc275290-bc41-4687-bcb4-3f8ac62365bd"
                  definition="#abd36e5a-eaa7-47b8-8c54-0e0cdbabce20" value="SES"/>
              <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="137e4676-162a-4153-adca-1b0d7605d1a0"
