                definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:vehicle-protection-v1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="4f60a1d5-8515-474f-a6f1-9349c7cb1b27"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="bounded_source_interpretation_requires_design_review"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="85a360f9-91c7-4c8c-95e2-11fd26681ff8"
                definition="#7d047b7b-d5c2-4581-a36c-9ea870bbae18" value="allocated_candidate_design"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="56e474c9-905f-4cc7-9c02-832ed093c97b"
                definition="#2386599d-283f-4676-a72d-71e2f2664451" value="not_verified"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="73a639e8-3ead-458f-a892-208441e60059"
                definition="#eb315afb-4ef3-4767-a9a9-d5588017eb0d" value="unresolved"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="972b96ed-34be-4343-b505-061fc7987ec7"
                definition="#93aadbc9-246e-4a0b-9571-805e6660044c" value="[&quot;Human-driven EV baseline; conditional oil/fuel/cooling/lithium hazards must be inventoried, not silently declared absent.&quot;,&quot;Only the specific outboard-motor/cable exception is retained; it does not exempt the rest of TS.&quot;]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="dfc3c163-de81-44f2-bceb-33e8cb4bd673"
                definition="#8ff3cafd-c645-43a7-887c-44038feac959" value="[&quot;Firewall geometry, aluminum layer/grounding, fluids/battery/cooling inventory and seals TBD.&quot;]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="b07259ff-e589-4136-b8f9-d60c727463e8"
                definition="#a106efc8-739d-4b81-b8a2-e2fcbdf4e89e" value="[&quot;EV.4.1.3&quot;,&quot;EV.7.7&quot;]"/>
