                definition="#7d047b7b-d5c2-4581-a36c-9ea870bbae18" value="allocated_candidate_design"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="d571c610-fdd2-4c52-9516-9c80d7fb080e"
                definition="#2386599d-283f-4676-a72d-71e2f2664451" value="not_verified"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="c354b24d-734e-4ac1-b11f-962cfd9a3ec7"
                definition="#eb315afb-4ef3-4767-a9a9-d5588017eb0d" value="unresolved"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="d696c15b-2e30-484c-9fc2-2bb696921f25"
                definition="#93aadbc9-246e-4a0b-9571-805e6660044c" value="[&quot;Human-driven EV: EV.8.2.2 applies; the published IC reference is retained as nonapplicable to this electric baseline.&quot;]"/>
