      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="f3e1c40b-4c64-43af-a2b4-83c0a5cad20d" name="FSAE2027:DD verify DD-11 NOT VERIFIED"
          summary="Review schematic, signal dependencies, power/fault paths and component implementation. Demonstrate that programmable APPS/BSE plausibility logic is not the BSPD implementation and cannot defeat its shutdown request. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Independent BSPD architecture and independence evidence still require design review. Source: FSAE-2027-V1:EV.8.7.1:p001, FSAE-2027-V1:EV.8.7.1:p002">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="1f79be54-d7d4-481d-a9e3-ab0e97bbc907">
          <bodies>Review schematic, signal dependencies, power/fault paths and component implementation. Demonstrate that programmable APPS/BSE plausibility logic is not the BSPD implementation and cannot defeat its shutdown request. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Independent BSPD architecture and independence evidence still require design review. Source: FSAE-2027-V1:EV.8.7.1:p001, FSAE-2027-V1:EV.8.7.1:p002</bodies>
