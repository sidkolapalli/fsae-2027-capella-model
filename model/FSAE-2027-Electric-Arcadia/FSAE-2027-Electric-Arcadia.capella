      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="960a2cf8-929c-37a6-a0c2-743385131b38" name="FSAE2027:VP Isolate occupants and harness from fluids, batteries and TS verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#9198d5f0-9b96-3a8a-a879-13e1df9f0b1a #c4a0d808-1cad-3d0b-8900-b2dde4e9ed7c #9d0880bf-8501-3c34-bb9a-a1504f84fe57 #dcbf78e0-d2bb-3009-935e-e6c7456b0a7e #ed0edd9f-e0b3-32fd-887f-b46ff04ed256 #c10c305b-39f9-3070-9662-607471afc21e #06a81ec3-89fa-3a4d-b54d-8de24e9060b3 #8a7a6d43-e5de-33d0-b8fb-7e59f88b087b #74687862-41f0-3fa6-8399-767433093db4 #620884cc-8046-3942-bde7-0f89ab86328f #91ff15ee-d493-3fcb-ae36-987e19448d03 #9fad6479-206c-3067-a582-7f60d1446f84 #0dc8a429-72f3-3496-9ca1-cf02f545968b #7a6f9a04-fcd9-3f93-a8ed-a124a43db2a8 #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="74c4d52a-684b-4ff6-b3e5-ef58a282d855">
          <bodies>Inventory all hazards/harness paths and inspect sightlines for tallest driver, layers, ground path, container separation, mounts and complete seals/grommets. Substantiate material flammability/permeability and environmental ratings.
Conditions/alternatives: Human-driven EV baseline; conditional oil/fuel/cooling/lithium hazards must be inventoried, not silently declared absent. Only the specific outboard-motor/cable exception is retained; it does not exempt the rest of TS.
Open choices: Firewall geometry, aluminum layer/grounding, fluids/battery/cooling inventory and seals TBD.
Dependencies outside this bounded interpretation: EV.4.1.3, EV.7.7
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="06fa2fe2-e54f-310e-9ccb-d140cea396b8" name="FSAE2027:VP Retain certified harness and posture-dependent alternatives verification NOT_VERIFIED"
