      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="af3f77cf-0f02-409a-972d-65bede5875f8" name="FSAE2027:DD verify DD-10 NOT VERIFIED"
          summary="Exercise mechanical-brake engagement with APPS below, at and above twenty-five percent. Demonstrate complete motor-power removal and persistence despite brake release until APPS is strictly below five percent; check the five-percent boundary. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Mechanical brakes engaged, not simply any nonzero pedal travel; EV.4.6/T.3.2.4 are retained as source dependencies. Source: FSAE-2027-V1:EV.4.7.1:p001, FSAE-2027-V1:EV.4.7.1:p002, FSAE-2027-V1:EV.4.7.1:p003, FSAE-2027-V1:EV.4.7.2:p001, FSAE-2027-V1:EV.4.7.2:p002, FSAE-2027-V1:EV.4.7.2:p003, FSAE-2027-V1:EV.4.7.2:p004">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="42aa8389-f237-42b2-aec2-c7b66ab91689">
          <bodies>Exercise mechanical-brake engagement with APPS below, at and above twenty-five percent. Demonstrate complete motor-power removal and persistence despite brake release until APPS is strictly below five percent; check the five-percent boundary. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Mechanical brakes engaged, not simply any nonzero pedal travel; EV.4.6/T.3.2.4 are retained as source dependencies. Source: FSAE-2027-V1:EV.4.7.1:p001, FSAE-2027-V1:EV.4.7.1:p002, FSAE-2027-V1:EV.4.7.1:p003, FSAE-2027-V1:EV.4.7.2:p001, FSAE-2027-V1:EV.4.7.2:p002, FSAE-2027-V1:EV.4.7.2:p003, FSAE-2027-V1:EV.4.7.2:p004</bodies>
          <languages>Text</languages>
