          <ownedRequirements xsi:type="Requirements:Requirement" id="49523599-ba4e-4fad-a537-f56a41bcb2a4"
              ReqIFIdentifier="FSAE2027:VP:obligation:AIP-COMPOSITE" ReqIFLongName="FSAE2027:VP Retain composite AIP strength and allowed substantiation paths"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="A composite AIP must survive frontal impact and withstand at least 120 kN static load distributed over the minimum 200 mm by 100 mm attenuator area. Verify either by physical testing attached to a representative intended chassis section with fixture equivalent to the baseline bulkhead or the first 50 mm of the chassis (data valid only one competition year), or by F.4.2.2/F.4.2.5 laminate tests with three-point-bending and perimeter-shear calculations.">
