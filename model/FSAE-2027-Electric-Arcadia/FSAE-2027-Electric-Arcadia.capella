      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="0e620086-89a3-3ff8-a2fb-544884bc8eb3" name="FSAE2027:VP Retain AIP material and attachment alternatives verification NOT_VERIFIED"
