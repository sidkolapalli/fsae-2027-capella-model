      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="727ca91e-de70-4d59-b8cd-593a0412779d" name="FSAE2027:DD verify DD-08 NOT VERIFIED"
          summary="Inspect direct routing and bias circuitry. Fault-inject each open, short, out-of-range and wiring failure; check persistence boundaries and complete motor-power removal. Establish actual sensor ranges and detection coverage. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Candidate analogue BSE. Digital BSE requirements and its form applicability remain unallocated. Source: FSAE-2027-V1:T.4.3.3:p001, FSAE-2027-V1:T.4.3.3:p002, FSAE-2027-V1:T.4.3.3:p003, FSAE-2027-V1:T.4.3.4:p001, FSAE-2027-V1:T.4.3.4:p002">
