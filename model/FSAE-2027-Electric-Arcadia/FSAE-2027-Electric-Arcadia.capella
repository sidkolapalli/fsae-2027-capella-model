          <ownedRequirements xsi:type="Requirements:Requirement" id="c951ec31-b099-4ec3-8da2-b546f7a57b68"
              ReqIFIdentifier="FSAE2027:VP:obligation:ROLLOVER" ReqIFLongName="FSAE2027:VP Provide hoops and restrained helmet clearances"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Provide front and main hoops triangulated into the primary structure by structural tubing. A hoop bend below its brace is triangulated at a side-view node or is strictly less than 25 mm from the applicable F.7.8 attachment. With the restraint installed, both the 95th-percentile male and every team driver's helmet have at least 50 mm clearance from the line joining hoop tops and, for rearward main bracing, at least 50 mm from the line from main-hoop top to brace lower end. With forward main bracing, the helmet lies no farther rearward than the main hoop's rear surface.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="150c7894-39cb-408a-88cc-7a504aa1261f"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
