                definition="#8ff3cafd-c645-43a7-887c-44038feac959" value="[&quot;Front packaging, aerodynamic devices, adjustment ranges and collision/motion evidence TBD.&quot;]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="842a6c0d-ecc9-46c7-87e7-3ca825b76012"
                definition="#a106efc8-739d-4b81-b8a2-e2fcbdf4e89e" value="[&quot;F.6.1&quot;,&quot;F.7.2&quot;,&quot;F.8.4.3&quot;]"/>
