          <ownedRequirements xsi:type="Requirements:Requirement" id="9b3c5e8d-ccdc-44f4-8401-41a9e4e4e95d"
              ReqIFIdentifier="FSAE2027:DD:DD-04" ReqIFLongName="Independent APPS channels and distinguishable transfer functions"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Use at least two electrically separate APPS sensors; two separate sensors in one OEM housing are permitted. Channel gradients and/or offsets differ. Bias open inputs to zero pedal travel. Above ten percent pedal position, each sensor output differs from every other by at least ten percent. Opposite slopes do not excuse this separation requirement. Calibration into comparable pedal-travel values is an unresolved design obligation.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="df493a6b-99d4-4fc7-b927-bfce84d8d74d"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="interpreted"/>
