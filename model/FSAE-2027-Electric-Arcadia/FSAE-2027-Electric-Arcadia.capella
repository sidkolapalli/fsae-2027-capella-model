      <ownedExtensions xsi:type="CapellaRequirements:CapellaModule" id="01a176a7-7ca6-430b-bd51-8904ea03d1df"
          ReqIFIdentifier="FSAE2027:SUB:module" ReqIFLongName="Formula SAE 2027 competition submissions (candidate readiness)">
        <ownedRequirements xsi:type="Requirements:Folder" id="6a3b0c97-1127-46f0-9e12-d3d322fedf5c"
            ReqIFIdentifier="FSAE2027:SUB:SES" ReqIFLongName="FSAE2027:SUB SES Structural Equivalency Spreadsheet (SES) and structural documentation"
            requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="The Structural Equivalency Spreadsheet (SES) is the SAE-provided Excel workbook (Table PS-1, XLSX, Tech group) in which every team documents its Primary Structure, proves equivalence of any non-baseline material or geometry to the steel-tube baseline, and documents front impact (AIP/IA attachment, with the IAD report attached) and, for EV, the tractive battery container and tractive-system protection. It is uploaded through the team's event-website account before the published pre-competition due date (months ahead of the event; the date is set on the website, not in the rules) and reviewed by an assigned SES reviewer whose comments must all be resolved. The approved copy is brought to Technical Inspection. Late upload costs 20 points per day; not submitting is grounds for removal. Model state: only the vehicle-protection slice rules (F.3.2-F.3.5, F.5.1, F.5.6-F.5.9, F.6.4, F.7.5, F.8, V.2.1) are traced to model elements and open verification checks; F.2, F.4, the rest of F.5/F.6/F.7, F.10, F.11 and the PS/IN process rules are not traced yet. An item is 'partial' when such a trace stands for it. The model holds no dimension, material or test value, so no item is 'present'. DEC-CHASSIS gates almost every item. Detailed IAD content is left to the IAD list; for F.10 the SES carries the structural proof of the battery container and its attachment (F.10.1.2, F.10.5.1) while the ESF carries the electrical design, so overlapping container items can be deduplicated by that split. The list also covers container openings and positive-locking retention (F.10.4, F.10.2.6, F.10.3.3), physical evidence brought to inspection (IN.6.1, F.10.3.5), and monocoque build evidence for a laminated-in Front Hoop (IN.6.3.2-IN.6.3.3).">
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="dcdc2f30-b13c-4a02-9d9c-01c1d4d64487"
              definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:submissions-v1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="85583d73-43c6-4fae-a734-19cbb6b42303"
              definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="dbb21c38-872d-4a3f-b9cd-2a20952b29d6"
              definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="bb8b3d54-8e50-44ea-bbd4-9e501a5ff122"
              definition="#abd36e5a-eaa7-47b8-8c54-0e0cdbabce20" value="SES"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="797b612d-f675-4493-976f-39349b7b230b"
              definition="#8418021d-4a12-4509-ab78-bf1394b884d6" value="[&quot;F.2.1 (FSAE-2027-V1:F.2.1.1:p001, F.2.1.2:p002-p004): the SES documents the Primary Structure, establishes equivalence and lets reviewers flag other concerns&quot;,&quot;F.2.2 (F.2.2.1:p001, F.2.2.2:p001): every team submits an SES and must close all reviewer comments&quot;,&quot;F.2.3 (F.2.3.1-F.2.3.3): equivalence uses SES methods against steel tubing in the same application; tubes and laminates may be combined&quot;,&quot;F.2.4 / F.2.5: tolerances handled in the SES; the car must be built as documented&quot;,&quot;PS.2.2 + TABLE-PS-1:p002: SES is an XLSX on the event template, Tech penalty group; TABLE-PS-2:p003 20 points per 24 h late, removal if not submitted (PS.3.3)&quot;,&quot;F.3.2.1 / F.3.4.1: application-to-size-class table (sizes A-D); fixed in the SES, not team inputs&quot;,&quot;F.3.4.2 / F.3.5.3: prescribed steel and 6061-T6 reference properties (welded and non-welded) used by the SES; not team inputs&quot;,&quot;F.3.5, F.4.1-F.4.4: alternative tubing and composite evidence and test methods&quot;,&quot;F.5.1-F.5.16, F.6.1-F.6.6, F.7.1-F.7.9: chassis, tube-frame and monocoque geometry/attachment rules evidenced in the SES&quot;,&quot;F.8.2.3, F.8.5.1, F.8.8.1: AIP and IA attachment plus the IAD report are part of the SES&quot;,&quot;F.10.1.2, F.10.1.3, F.10.5.1, F.11: battery container design/attachment and tractive-system protection are reviewed through the SES&quot;,&quot;EV.5.1.3, IN.6.1: battery hardware must match the SES; SES copy at technical inspection&quot;,&quot;F.10.4, F.10.2.6, F.10.3.3, F.10.1.6: container openings, positive locking of lids and module mounts, rivet guidance; part of the container design reviewed through the SES (F.10.1.3)&quot;,&quot;IN.6.1 (p006), IN.6.3.2-IN.6.3.3, F.10.3.5 (p004): laminate specimens, tested module structure and monocoque build evidence presented at Technical Inspection&quot;]"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="277b67fd-443b-4854-8aca-9e874014d0dd"
              definition="#80d1a35c-a9c8-40de-a65a-a8e64d29b2ab" value="XLSX"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="0a2a8fbd-8fd0-45ee-ae81-0e71da8a6c90"
              definition="#62888c91-f380-493e-8eae-b8faff556830" value="Tech"/>
