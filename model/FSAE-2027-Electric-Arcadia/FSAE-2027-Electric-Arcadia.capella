          id="97ac378c-744a-41e4-8639-3c22bc7a7ec7" name="FSAE2027:DD verify DD-13 NOT VERIFIED"
          summary="Prepare an approved safe inspection procedure, isolate motor power and record that no motor power is delivered. Apply external current through the separate stimulus wire while pressing the brake; verify current-sensor response and full BSPD shutdown operation. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Installed-vehicle test; isolated stimulus is not proof obtained by the model script. Source: FSAE-2027-V1:EV.8.7.4:p001, FSAE-2027-V1:EV.8.7.4:p002, FSAE-2027-V1:EV.8.7.4:p003, FSAE-2027-V1:EV.8.7.4:p004">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="e9673606-d3c2-4b67-9404-c99c92fcd987">
          <bodies>Prepare an approved safe inspection procedure, isolate motor power and record that no motor power is delivered. Apply external current through the separate stimulus wire while pressing the brake; verify current-sensor response and full BSPD shutdown operation. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Installed-vehicle test; isolated stimulus is not proof obtained by the model script. Source: FSAE-2027-V1:EV.8.7.4:p001, FSAE-2027-V1:EV.8.7.4:p002, FSAE-2027-V1:EV.8.7.4:p003, FSAE-2027-V1:EV.8.7.4:p004</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
