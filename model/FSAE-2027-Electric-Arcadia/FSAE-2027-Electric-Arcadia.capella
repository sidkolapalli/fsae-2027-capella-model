                source="#7d3faed0-b9c9-45da-855b-76902f999053" target="#1588d66d-509e-4b67-b958-31b69310aea9"/>
            <ownedRelations xsi:type="Requirements:InternalRelation" id="e87cb830-e5ca-432c-9cbe-8c3fac9ea85d"
                ReqIFLongName="derive" relationType="#809594af-637b-44eb-ab1a-592b3c96040b"
                source="#7d3faed0-b9c9-45da-855b-76902f999053" target="#9da96976-24f2-4578-b5ee-63714b958e2f"/>
            <ownedRelations xsi:type="Requirements:InternalRelation" id="90f72f21-8364-4f50-97a7-27eaeae4636e"
                ReqIFLongName="derive" relationType="#809594af-637b-44eb-ab1a-592b3c96040b"
                source="#7d3faed0-b9c9-45da-855b-76902f999053" target="#72fe45f7-d1be-4ab7-a4c1-08e6bec62b5f"/>
            <ownedRelations xsi:type="Requirements:InternalRelation" id="7eb09d8f-54c3-4502-90e0-c4d1da76dbb6"
