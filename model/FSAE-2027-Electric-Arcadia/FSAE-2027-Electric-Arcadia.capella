              definition="#e74563e6-54e4-4b1e-9564-bbeaadb5f842" value="shutdown independent BSPD / shutdown circuit interface"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="00924efe-fd0d-4fb8-be30-7ec5737425b2"
              definition="#24dab7e7-9bdb-4a7d-a787-ade81adc5a7f" value="inspection_review_and_fault_injection"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="c4dade1d-5867-4724-88e3-8c9c8d51680b"
              definition="#a6f8b280-f501-44d6-b974-e0c0e356134b" value="not_available"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="653be5e4-8cd8-45fd-b126-3c7baa3156b0"
              definition="#41afa17f-634c-41e7-979f-4215631eb35d" value="not_claimed"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="851903ab-9762-4660-892a-c6a9e31fb74a"
              definition="#cd92da3c-dabc-4352-8406-10793ad92c60" value="Open the shutdown circuit when hard braking coincides for longer than half a second with tractive current corresponding to five kilowatts delivered to motors at nominal battery voltage. Also open the shutdown circuit for any open or short on a BSPD sensor input. The symbolic current threshold is 5000 W divided by nominal battery voltage; the voltage, hard-braking criterion and actual circuit design remain unresolved. Global trip latching/manual-reset behavior belongs to the separate shutdown slice."/>
          <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation" id="e9e01ac0-9651-4670-974f-51933964cb03"
              ReqIFLongName="verify" relationType="#9cfd44cc-2aa9-4909-9ee5-e8c8fd3f4546"
              source="#05096ae7-80ab-447a-ab83-cede60066991" target="#31827f65-2ee5-4b0d-a80e-523a1248fd1e"/>
        </ownedRequirements>
