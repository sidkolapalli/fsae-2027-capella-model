      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="1a145fed-66b4-3ade-9fde-bd836ca6bcc5" name="FSAE2027:VP Meet all steel minima and prescribed calculation properties verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#a38b781a-d3b4-3211-869b-3828344fa293 #4aa2525e-f7cd-38a6-a501-c6687cc41946 #94a3d826-a612-3513-8eb3-df5805639f86 #2904fe19-f7ed-30f3-9664-f8e37fe45fe8 #ed2109e2-36e4-3bfe-ad7d-3586083ae889 #53e89cde-5638-3ca6-9f89-f868f7647f38 #73aa2539-f087-3106-a899-6773dbe53099 #cd5566c8-0d9f-3d3d-aa31-1cd3da537f6c #12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1 #20c5e3a3-d48e-3dfb-b074-539aa988e34a #d40229d7-2efc-3afd-8d10-df1a12902857 #b74914b4-417f-34ad-b663-6fce440b6925 #a8d2f357-a3f6-38c6-8f8c-f03098647dae #dfc544c7-48fa-3561-a2e6-30ce6007c419 #2ac64ffd-f3f9-352c-b5a9-21ebab8188fa #571541be-6a5f-3daa-81d8-c6aaed41d551 #d326dc8a-b6ce-329b-87d9-7ff7f7576a52 #db1bf125-5330-3fef-913d-5365cd9aab7f #052ba2b8-5209-3aa1-99ce-51eb55d39957 #ef1f0d00-f007-3a47-8bf7-bb723b1b2c90 #fbd35ccd-e300-309b-a64f-30b004a87f46 #c3eda33c-5bf7-30ed-a651-da90fa8e2f38 #e33dae75-9a3b-3822-b382-372f6c891a37 #28b391ad-021f-39ba-ac10-fb4bafe83ae3 #87dff644-a41a-3feb-a7bd-457120b567bd">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="1031a18d-a727-44a1-b5b4-316672d72845">
          <bodies>Measure selected tubing and calculate inertia/area. Audit SES material cards, continuous/joint properties, reinforcement equivalence, insert dimensions and both end welds; inspect structural welds for mechanical reshaping.
Conditions/alternatives: All four class minima apply together; weld and reinforcement conditions are not optional substitutes.
Open choices: Steel grade, purchased dimensions/tolerances, members, joints and reinforcement details TBD.
Dependencies outside this bounded interpretation: 
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="1155865f-6d91-3fef-b5a5-c0689960fcca" name="FSAE2027:VP Retain conditional aluminum construction and evidence verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#a38b781a-d3b4-3211-869b-3828344fa293 #4aa2525e-f7cd-38a6-a501-c6687cc41946 #94a3d826-a612-3513-8eb3-df5805639f86 #2904fe19-f7ed-30f3-9664-f8e37fe45fe8 #ed2109e2-36e4-3bfe-ad7d-3586083ae889 #53e89cde-5638-3ca6-9f89-f868f7647f38 #73aa2539-f087-3106-a899-6773dbe53099 #cd5566c8-0d9f-3d3d-aa31-1cd3da537f6c #20c5e3a3-d48e-3dfb-b074-539aa988e34a #d40229d7-2efc-3afd-8d10-df1a12902857 #b74914b4-417f-34ad-b663-6fce440b6925 #a8d2f357-a3f6-38c6-8f8c-f03098647dae #dfc544c7-48fa-3561-a2e6-30ce6007c419 #2ac64ffd-f3f9-352c-b5a9-21ebab8188fa #571541be-6a5f-3daa-81d8-c6aaed41d551 #d326dc8a-b6ce-329b-87d9-7ff7f7576a52 #db1bf125-5330-3fef-913d-5365cd9aab7f #052ba2b8-5209-3aa1-99ce-51eb55d39957 #ef1f0d00-f007-3a47-8bf7-bb723b1b2c90 #fbd35ccd-e300-309b-a64f-30b004a87f46 #c3eda33c-5bf7-30ed-a651-da90fa8e2f38 #e33dae75-9a3b-3822-b382-372f6c891a37 #28b391ad-021f-39ba-ac10-fb4bafe83ae3 #87dff644-a41a-3feb-a7bd-457120b567bd">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="b517485c-31fe-48aa-9d2f-5520e72b0401">
          <bodies>Audit material provenance, thicknesses, manufacturing records, reference-property use and every equivalence mode. If claiming postweld strength recovery, review complete treatment/fixturing/thermal history evidence.
Conditions/alternatives: Only if aluminum is selected; no aluminum material or heat-treatment waiver is selected.
Open choices: Aluminum applicability, alloy, welding and heat-treatment choices TBD.
Dependencies outside this bounded interpretation: 
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="f759142c-6f97-3d26-9bb9-b7f7085005a2" name="FSAE2027:VP Provide hoops and restrained helmet clearances verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1 #74687862-41f0-3fa6-8399-767433093db4 #620884cc-8046-3942-bde7-0f89ab86328f #91ff15ee-d493-3fcb-ae36-987e19448d03 #9fad6479-206c-3067-a582-7f60d1446f84 #0dc8a429-72f3-3496-9ca1-cf02f545968b #7a6f9a04-fcd9-3f93-a8ed-a124a43db2a8 #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92 #f01a7ccc-d68c-33ef-98f8-0f856c433115 #225caf86-55f8-3039-a19a-e784bcdd3782 #41c8926b-0c8a-3fbb-96d6-174bf31b4e12 #25e1d90d-e556-30cc-9d3d-a793da6cedd6 #4105e544-64b9-30bc-8675-e227c7a85623 #3adb2e27-64ea-3014-be8b-4a7dbd5696a0 #b925e0db-fbab-3d65-9bbd-72354742d1cf #6eea27b1-3e56-3a06-93c1-4bf9204eae65">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="a6ca7b44-2040-49c2-99bf-7721ca8f8f22">
          <bodies>Inspect hoops and load-path triangulation, measure each bend/attachment and restrained helmet clearance for the anthropometric template and all team drivers in the selected bracing configuration.
Conditions/alternatives: Brace direction controls the helmet envelope; the alternative bend treatment must be explicitly selected.
Open choices: Hoop geometry, brace direction, bend nodes, attachment type and driver envelopes TBD.
Dependencies outside this bounded interpretation: F.7.8
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="adee0735-bef4-3cd4-a532-d807e34c513a" name="FSAE2027:VP Use the prescribed template and inspection position verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#74687862-41f0-3fa6-8399-767433093db4 #620884cc-8046-3942-bde7-0f89ab86328f #91ff15ee-d493-3fcb-ae36-987e19448d03 #9fad6479-206c-3067-a582-7f60d1446f84 #0dc8a429-72f3-3496-9ca1-cf02f545968b #7a6f9a04-fcd9-3f93-a8ed-a124a43db2a8 #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92 #12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1 #06216d7b-fa44-339e-9292-99f66da96741 #390692d6-c92d-3f94-8c69-6a484d4ba61b #05f8ebd0-ed9e-322f-a71a-fd94ba0ff0fb #da4c5187-5324-3b91-b09c-0157058223c3 #01d6566b-71e8-3aa8-b7f2-7145332325e7 #8f9af362-02b8-3a1a-bd6a-37be22199041 #1ce1426e-0127-3121-bacb-03134e3b0b46 #51334761-7870-3b7c-a78f-a6c74fd93ebe">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="da511f7e-e4be-48b7-a757-7ff62a767e38">
          <bodies>Construct and dimension-check the prescribed template. Record its placement with seat/pedal extremes and verify 915 mm minimum and 25 mm maximum gaps before evaluating helmet geometry.
Conditions/alternatives: This inspection template does not replace the full required driver population.
Open choices: Seat/pedal adjustment ranges, head-restraint adjustment and physical template evidence TBD.
Dependencies outside this bounded interpretation: 
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="784ff995-f5a2-30a3-92bb-b43ad37d4d72" name="FSAE2027:VP Constrain front-hoop material and geometry verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1 #74687862-41f0-3fa6-8399-767433093db4 #620884cc-8046-3942-bde7-0f89ab86328f #91ff15ee-d493-3fcb-ae36-987e19448d03 #9fad6479-206c-3067-a582-7f60d1446f84 #0dc8a429-72f3-3496-9ca1-cf02f545968b #7a6f9a04-fcd9-3f93-a8ed-a124a43db2a8 #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92">
