                definition="#28b77914-98e1-4e31-9f99-9f81e58c2b65" value="driver-demand-v1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="016e4cf0-3c53-41f1-aa3d-427852d413bd"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="31cd64cc-7503-4cc6-9a5d-ba0732bf6da0"
