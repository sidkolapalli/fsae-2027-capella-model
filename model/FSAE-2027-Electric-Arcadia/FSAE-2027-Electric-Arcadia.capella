          <ownedRequirements xsi:type="Requirements:Requirement" id="0d74757e-c9ed-47b5-b418-b864ae1864da"
              ReqIFIdentifier="FSAE2027:VP:obligation:SIDE-MONOCOQUE" ReqIFLongName="FSAE2027:VP Retain monocoque side-impact equivalence and physical tests"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="For a monocoque define the side-impact zone between hoops as at least 290 mm of vertical height above the floor bottom plus half the horizontal floor. Establish equivalence to three class B steel tubes. The vertical portion from floor bottom to 345 mm above the floor's lowest bottom point is equivalent to at least two class B steel tubes and has no side-view openings between hoops. Calculate horizontal-floor equivalence under F.4.3. For a 25 mm-diameter laminate section show perimeter shear of at least 7.5 kN by the F.4.2.5 physical test and include results in the SES.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="9a79e5ad-5dcd-4128-b82e-031a7d5ec9d5"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="891d9238-d078-42c6-bc99-b91c9d97d37f"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="bb0d895c-9f15-430f-a518-9ee60b527db3"
