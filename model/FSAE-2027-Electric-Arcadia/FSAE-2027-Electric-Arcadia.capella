                          target="#71ff7a0d-42a9-4639-ab1d-4cf6537d7dc0"/>
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="84e1f365-21f6-4731-80e6-c406b4b47494">
                        <bodies>All series contacts healthy/closed; GLV present; BMS IMD BSPD protective latch clear; applicable TS activation requirements independently satisfied. Detailed activation EV.12 design TBD.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="98aaa58a-6c47-3761-accd-c2b6da0e1f68" name="FSAE2027:SD Any trip removes energy"
                      triggerDescription="Series-current loss or protective trip"
