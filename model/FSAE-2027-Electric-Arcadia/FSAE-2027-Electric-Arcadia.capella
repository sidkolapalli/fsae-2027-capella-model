          <ownedRequirements xsi:type="Requirements:Requirement" id="19d7596f-06d8-4a0d-bcd8-5bab9c9a03cc"
              ReqIFIdentifier="FSAE2027:VP:obligation:PEDAL" ReqIFLongName="FSAE2027:VP Protect mechanical pedal strength and operation"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Pedal material/manufacture is fabricated steel/aluminum or machined steel/aluminum/titanium. Pedal and associated parts withstand at least 2000 N without failure of brakes, box, chassis mount or adjustment. The source explicitly says this is not a design criterion and allows seated-official maximum-force pedal testing; a 2000 N calculation alone is not accepted as completed design verification. Failure of non-loadbearing brake/box parts must never obstruct pedal or brake operation.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="15b797d1-b816-4cc8-bac2-e1c104c3b314"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
