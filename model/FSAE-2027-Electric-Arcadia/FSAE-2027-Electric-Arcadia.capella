              <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                  id="bd4ef6b2-fd90-49a1-9c21-792f58e42793" name="FSAE2027:DD LA motor inhibit arbitration"
                  summary="Candidate output contract: OR all qualified APPS fault, BSE fault, brake-conflict latch and independent shutdown inhibits; any active inhibit means zero power to every motor and zero commanded regenerative torque. No alternate command path may bypass this output gate. Otherwise accept only driver-bounded total wheel torque, forward-drive authorization and low-speed regeneration authorization. Powertrain design and measured output evidence remain UNRESOLVED and NOT VERIFIED.">
                <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                    id="d391db7f-7476-4316-8c67-a89a4a392f74">
                  <bodies>Candidate output contract: OR all qualified APPS fault, BSE fault, brake-conflict latch and independent shutdown inhibits; any active inhibit means zero power to every motor and zero commanded regenerative torque. No alternate command path may bypass this output gate. Otherwise accept only driver-bounded total wheel torque, forward-drive authorization and low-speed regeneration authorization. Powertrain design and measured output evidence remain UNRESOLVED and NOT VERIFIED.</bodies>
                  <languages>Text</languages>
                </ownedSpecification>
              </ownedConstraints>
