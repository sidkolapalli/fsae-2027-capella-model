        <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="30b3dacd-f37c-458d-93bd-f31e83e10bb9"
            ReqIFLongName="satisfy" relationType="#2e468c6c-54f1-46f0-b2f9-9cc10213ce71"
            source="#2fa518d5-f101-3ea4-a6d3-ede1a233238b" target="#a409e5d5-7f74-47de-9f22-18b7187eb5b6"/>
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="f07bded8-5df2-4b9c-8350-9071b6c5a7c7">
          <bodies>Every listed contact directly carries the high-side sustaining current to all isolation/precharge coil branches. TSMS is the final switch, followed only by permitted interlocks/precharge circuitry. No bypass or backfeed source may energize these loads after any contact opens. Ratings and exact wiring remain TBD.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="ac7b2ef0-c295-3cfc-ae45-3ec7ea617aa0" name="FSAE2027:SD External safety dependencies TBD"
          summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
          constrainedElements="#8f93c3ec-9470-3261-90a2-917ed6927fd9 #e436c4bf-ac03-31cd-8bcc-74875eda44ba #3a814d52-924f-3289-9c2a-1b03f8a93126">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="a2697ecb-35c0-4fe9-9984-e7afa6886f10">
          <bodies>Review T.3.3 BOTS, T.9.4 inertia switching, T.9.1.2 low-voltage limits, T.9.3 master-switch configuration/location, EV.5.4 isolation relays, EV.6 status/lamp check, EV.8.7 independent BSPD, EV.9 charging, EV.12 activation and reset work practices, and the current approved IMD FAQ before closing this design.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
