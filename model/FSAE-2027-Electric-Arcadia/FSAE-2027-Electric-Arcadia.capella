      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="e222fae6-18bc-4ea7-8543-8045504884f8" name="FSAE2027:DD decision unresolved calibration thresholds and recovery"
          summary="UNRESOLVED: APPS ranges and raw transfer calibration; BSE range and mechanical engagement; hard-braking threshold; nominal battery voltage and BSPD current threshold; sampling and timer tolerances; low-speed interval endpoints and invalid-speed behavior; approved sensor-fault recovery; inspection isolation and jack colour/location; hardware selection and ratings. BSPD no automatic reset: shutdown slice owns EV.8.2.2 manual latch recovery. Source examples 0.5/4.5 V are not mandatory universal thresholds.">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="a702cc3a-f61e-4ca3-9149-785ba850753b">
          <bodies>UNRESOLVED: APPS ranges and raw transfer calibration; BSE range and mechanical engagement; hard-braking threshold; nominal battery voltage and BSPD current threshold; sampling and timer tolerances; low-speed interval endpoints and invalid-speed behavior; approved sensor-fault recovery; inspection isolation and jack colour/location; hardware selection and ratings. BSPD no automatic reset: shutdown slice owns EV.8.2.2 manual latch recovery. Source examples 0.5/4.5 V are not mandatory universal thresholds.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="378eae84-12de-4fe5-b03e-800853b5dee8" name="FSAE2027:DD verify DD-01 NOT VERIFIED"
          summary="Review every torque-adjusting path and reverse command path. Bench-sweep driver requests, limiting interventions and direction requests; confirm requested total torque is never increased and powered reverse is rejected. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Human-driven electric baseline; any algorithm or ECU able to adjust wheel torque. Source: FSAE-2027-V1:EV.3.1.1:p001, FSAE-2027-V1:EV.3.1.3:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="9e60d6ba-9f0b-4b01-9822-d3af977b37dd">
          <bodies>Review every torque-adjusting path and reverse command path. Bench-sweep driver requests, limiting interventions and direction requests; confirm requested total torque is never increased and powered reverse is rejected. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Human-driven electric baseline; any algorithm or ECU able to adjust wheel torque. Source: FSAE-2027-V1:EV.3.1.1:p001, FSAE-2027-V1:EV.3.1.3:p001</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="2dcc2d79-76f8-4de9-aba8-6af2bd4931aa" name="FSAE2027:DD verify DD-02 NOT VERIFIED"
          summary="Review interval endpoint interpretation. Bench-test below, at and above 0 and 5 km/h, including invalid speed input, and measure absence of regenerative energy within the approved inhibited interval. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Regenerative powertrain operation; speed measurement and invalid-speed behavior remain engineering decisions. Source: FSAE-2027-V1:EV.3.3.3:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="c4ce8043-0329-4a6e-8aeb-58f1599415ec">
          <bodies>Review interval endpoint interpretation. Bench-test below, at and above 0 and 5 km/h, including invalid speed input, and measure absence of regenerative energy within the approved inhibited interval. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Regenerative powertrain operation; speed measurement and invalid-speed behavior remain engineering decisions. Source: FSAE-2027-V1:EV.3.3.3:p001</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="94a4e731-87d6-4822-8042-70c6f6d5709a" name="FSAE2027:DD verify DD-03 NOT VERIFIED"
          summary="Inspect two pedal springs and their independence from APPS internals. Disconnect each spring in turn and demonstrate the remaining spring returns the pedal to zero travel throughout the approved operating conditions. Evidence: unavailable. Status: NOT VERIFIED. Conditions: All accelerator pedal implementations. Source: FSAE-2027-V1:T.4.2.1:p001, FSAE-2027-V1:T.4.2.1:p002, FSAE-2027-V1:T.4.2.1:p003">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="b3032ac9-5d4f-4fe0-bfbb-74040ed76c4a">
          <bodies>Inspect two pedal springs and their independence from APPS internals. Disconnect each spring in turn and demonstrate the remaining spring returns the pedal to zero travel throughout the approved operating conditions. Evidence: unavailable. Status: NOT VERIFIED. Conditions: All accelerator pedal implementations. Source: FSAE-2027-V1:T.4.2.1:p001, FSAE-2027-V1:T.4.2.1:p002, FSAE-2027-V1:T.4.2.1:p003</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="ad33b1ae-20d0-4af8-bc3a-7a6b7559cb81" name="FSAE2027:DD verify DD-04 NOT VERIFIED"
          summary="Inspect electrical independence and bias circuitry. Measure raw transfer functions over pedal travel, demonstrate required separation and zero-travel open-input behavior, and review calibrated comparison to avoid confusing raw-channel separation with plausibility deviation. Evidence: unavailable. Status: NOT VERIFIED. Conditions: This candidate selects two analogue channels. It does not select the optional three-sensor degraded mode. Source: FSAE-2027-V1:T.4.2.2:p001, FSAE-2027-V1:T.4.2.3:p001, FSAE-2027-V1:T.4.2.3:p002, FSAE-2027-V1:T.4.2.3:p003, FSAE-2027-V1:T.4.2.3:p004, FSAE-2027-V1:T.4.2.3:p005">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="803ffae2-e321-42c6-82cd-515ab3f37b23">
          <bodies>Inspect electrical independence and bias circuitry. Measure raw transfer functions over pedal travel, demonstrate required separation and zero-travel open-input behavior, and review calibrated comparison to avoid confusing raw-channel separation with plausibility deviation. Evidence: unavailable. Status: NOT VERIFIED. Conditions: This candidate selects two analogue channels. It does not select the optional three-sensor degraded mode. Source: FSAE-2027-V1:T.4.2.2:p001, FSAE-2027-V1:T.4.2.3:p001, FSAE-2027-V1:T.4.2.3:p002, FSAE-2027-V1:T.4.2.3:p003, FSAE-2027-V1:T.4.2.3:p004, FSAE-2027-V1:T.4.2.3:p005</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="9a8199d8-7e4c-49c3-9fa0-45b2cf896855" name="FSAE2027:DD verify DD-05 NOT VERIFIED"
          summary="Fault-inject each open, short, out-of-range and channel-deviation condition. Check strict threshold and persistence boundaries and complete motor-power removal after qualification. Document actual ranges, bias response and any proposed larger deviation threshold approval. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Analogue APPS candidate; actual sensor operating range remains unresolved. Source: FSAE-2027-V1:T.4.2.4:p001, FSAE-2027-V1:T.4.2.5:p001, FSAE-2027-V1:T.4.2.5:p002, FSAE-2027-V1:T.4.2.9:p001, FSAE-2027-V1:T.4.2.10:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="bafb9083-ea95-4c4c-bc87-37942183a5dd">
          <bodies>Fault-inject each open, short, out-of-range and channel-deviation condition. Check strict threshold and persistence boundaries and complete motor-power removal after qualification. Document actual ranges, bias response and any proposed larger deviation threshold approval. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Analogue APPS candidate; actual sensor operating range remains unresolved. Source: FSAE-2027-V1:T.4.2.4:p001, FSAE-2027-V1:T.4.2.5:p001, FSAE-2027-V1:T.4.2.5:p002, FSAE-2027-V1:T.4.2.9:p001, FSAE-2027-V1:T.4.2.10:p001</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="8520efd0-1f68-456f-b443-3125437cc441" name="FSAE2027:DD verify DD-06 NOT VERIFIED"
          summary="Inspect each channel's direct signal route and detachable connector. During technical inspection disconnect each channel independently and demonstrate the monitor and inhibit functions. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Candidate analogue transmission; digital failure-mode obligations remain outside this selected variant. Source: FSAE-2027-V1:T.4.2.7:p001, FSAE-2027-V1:T.4.2.7:p002, FSAE-2027-V1:T.4.2.7:p003, FSAE-2027-V1:T.4.2.8:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="327cc544-7eeb-4dfb-aa68-99d61226431a">
          <bodies>Inspect each channel's direct signal route and detachable connector. During technical inspection disconnect each channel independently and demonstrate the monitor and inhibit functions. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Candidate analogue transmission; digital failure-mode obligations remain outside this selected variant. Source: FSAE-2027-V1:T.4.2.7:p001, FSAE-2027-V1:T.4.2.7:p002, FSAE-2027-V1:T.4.2.7:p003, FSAE-2027-V1:T.4.2.8:p001</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="c048607b-1b24-4247-998d-636bd917d7b1" name="FSAE2027:DD verify DD-07 NOT VERIFIED"
          summary="Inspect the selected sensing principle and calibrate its relation to brake demand. Establish the mechanical-brake-engagement and hard-braking criteria from the actual brake design; record supporting evidence. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Brake encoder candidate; hard-braking and mechanical-brake-engagement criteria must be substantiated separately. Source: FSAE-2027-V1:T.4.3.1:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="3db5476e-aaf0-4cae-aab1-ec07fd355a8d">
          <bodies>Inspect the selected sensing principle and calibrate its relation to brake demand. Establish the mechanical-brake-engagement and hard-braking criteria from the actual brake design; record supporting evidence. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Brake encoder candidate; hard-braking and mechanical-brake-engagement criteria must be substantiated separately. Source: FSAE-2027-V1:T.4.3.1:p001</bodies>
