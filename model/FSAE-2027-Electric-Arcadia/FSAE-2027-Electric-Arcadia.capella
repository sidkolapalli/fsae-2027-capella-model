          <ownedRequirements xsi:type="Requirements:Requirement" id="facfeb32-8a24-47d7-9b2a-695365bc2cbe"
              ReqIFIdentifier="FSAE2027:VP:obligation:SIDE-TUBE" ReqIFLongName="FSAE2027:VP Retain the tube-frame side-impact alternative"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="For a tube-frame side-impact structure use closed tubing of the applicableB orD class, with at least three members on each side of the seated driver. Multiple pieces require straight unbent tubes and correct triangulation. The upper member joins the main and front hoops with its entire top edge in a ground-parallel 290–345 mm band above the lower member's lowest bottom point. The lower member joins both hoop bottoms. A diagonal ahead of the main hoop and behind the front hoop connects upper/lower members and completely triangulates their bays.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="b53a8ba5-c959-4eaa-866c-b543e6015628"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
