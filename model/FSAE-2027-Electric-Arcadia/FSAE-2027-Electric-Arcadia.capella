        <ownedRequirements xsi:type="Requirements:Folder" id="361e1806-d039-4553-b6d1-52736a13a420"
            ReqIFIdentifier="FSAE2027:SUB:ESF" ReqIFLongName="FSAE2027:SUB ESF Electrical System Form (ESF)"
            requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="The ESF is the EV-only technical document in which the team describes the complete vehicle electrical system (tractive system, GLV and control) in a structured way (EV.2.1.1). It is filed before the competition on the official SAE-supplied XLSX template, with the format unchanged, as a single file uploaded through the team's Event Website account by the posted due date (EV.2.1.3, PS.2, TABLE-PS-1:p006). An event official assigned as Reviewer checks and accepts it. Reviewers may ask for revisions with new deadlines (PS.1.2.8, PS.3.1.3). The ESO/ESA form (the Electrical System Officer and Advisor details, PDF, Tech group) is a separate upload with the same removal risk; it is tracked as GEN-PS1-02 on the general page. Before upload, the team's Electrical System Advisor must review it (AD.5.3.6). It is in the Tech penalty group: -20 points per 24 h late, and if it is still missing at the cancellation date, that is grounds for removing the entry (EV.2.2, TABLE-PS-2:p003, PS.3.3.1). Approval does not guarantee passing inspection (EV.2.1.1:p002). A copy plus component datasheets must be brought to accumulator and charger inspection (IN.5.1:p006), and the built pack and spares must match it (EV.5.1.3). The rulebook names only two content items as ESF-specific: BMS module-boundary isolation (EV.8.3.2) and pack configuration identity (EV.5.1.3). The rest of this list is derived from the EV and T rules the form must describe. The tab layout of the 2027 workbook is not public without a team login, so the section headings here are our own, not the template's. FSAE-2027-V1 has no general FMEA requirement. Failure-mode write-ups appear only for digital APPS/BSE transmission and are tied to the ETC Systems Form (T.4.2.11:p002, T.4.3.5:p002, IC.4.4.9). T.4.3.5:p002 is not marked IC-only, so an EV team that sends the BSE signal over a bus should confirm through a Rules Question where to document it.">
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="33decf49-eea3-4a60-8e85-beba9e340aa8"
              definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:submissions-v1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="8dae929e-499d-4667-859e-56adabe3f533"
              definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="aeb112d9-34d6-4dad-aa6a-e61e564c9552"
              definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="bf6b4e63-de71-4cc9-aea9-bb737d29b675"
              definition="#abd36e5a-eaa7-47b8-8c54-0e0cdbabce20" value="ESF"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="73c65fa6-03aa-4344-943d-ed1bdde21926"
              definition="#8418021d-4a12-4509-ab78-bf1394b884d6" value="[&quot;EV.2.1.1 - every team submits an ESF giving clearly structured documentation of the full electrical system, TS and control included; approval does not mean the car passes inspection&quot;,&quot;EV.2.1.2 - the ESF may carry guidance or detail beyond the rulebook&quot;,&quot;EV.2.1.3 - use the provided format and submit per section PS&quot;,&quot;EV.2.2 - ESF penalties follow section PS&quot;,&quot;TABLE-PS-1:p006 / TABLE-PS-1:p014 - ESF: XLSX, Tech penalty group, use the Event Website template&quot;,&quot;TABLE-PS-2:p003 - Tech group: -20 points per 24 h late; missing after the deadline is grounds for removal&quot;,&quot;PS.1.1.1, PS.1.2.2-PS.1.2.8 - due date, cancellation date, late, not-submitted, removal and Reviewer definitions&quot;,&quot;PS.2.1, PS.2.2.1-PS.2.2.4 - upload to team account; template format unaltered; one file&quot;,&quot;PS.3.1.1-PS.3.1.4, PS.3.2.1-PS.3.2.3, PS.3.3.1-PS.3.3.2 - team responsibility, revision requests, penalties and entry removal&quot;,&quot;AD.5.3.6 - ESA reviews the ESF and confirms sound engineering practice in principle; AD.5.3.7 - ESA makes sure unusual design aspects are communicated&quot;,&quot;IN.5.1:p006 - ESF and component datasheets brought to accumulator/charger inspection&quot;,&quot;EV.5.1.3 - pack components, containers and spares identical to the design in the ESF and SES&quot;,&quot;EV.8.3.2 - BMS galvanic isolation at module boundaries is approved through the ESF&quot;,&quot;Content rules described by the form: EV.1, EV.3-EV.10, T.3.3, T.4.2, T.4.3, T.5.3, T.9.1-T.9.4, IN.10 (expected test results); F.10 and F.11 by cross-reference to the SES&quot;]"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="26619514-90dc-42a6-a4e6-27e0fb6cf234"
              definition="#80d1a35c-a9c8-40de-a65a-a8e64d29b2ab" value="XLSX"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="6c4b8e26-500c-4111-a9d2-481a27518ee8"
              definition="#62888c91-f380-493e-8eae-b8faff556830" value="Tech"/>
