        <ownedRequirements xsi:type="Requirements:Folder" id="fcc87ca0-a075-43a1-b678-4dd6b9ef1876"
            ReqIFIdentifier="FSAE2027:SUB:COST" ReqIFLongName="FSAE2027:SUB COST Cost Report (Cost and Manufacturing Event, with its Cost Addendum and Cost Scenario companions)"
            requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="The Cost Report is the team's priced bill of materials for the whole prototype. It is built and uploaded in the Event Website's cost tool, in whatever form that site specifies (Table PS-1 note 2), and it is due before the competition at the Due Date posted on the Event Website. The Cost Event is worth 100 points in total (S.3.16.2), and the Cost Judges assess the report against the car at the competition (S.3.13.4). At the competition the judges hold a discussion beside the car, comparing the report with the vehicle as presented and judging whether the car could be manufactured. Teams may also be picked for a Cost Audit. Table PS-1 puts the Cost Report in penalty group Other. Under Table PS-2 that means -20 points for each 24 hours late, with any part of a day counted as a full day. A report not submitted by the Cancellation Date removes the team from the Cost event with a score of zero. Every price must come from the official Cost Tables, built up by vehicle, then system, then assembly, then part, then material, process, fastener and tooling. The Cost Event Supplement on the Event Website carries the detailed costing guidance (S.3.2); the public Supplement is where the system categories and tooling method are defined. Two related deliverables follow. The Cost Addendum is handed in at onsite registration on a template and covers changes made after submission. The Cost Scenario submission is required only if that year's scenario document asks for it, and Table PS-1 also puts it in penalty group Other. Penalties work two ways. Method A deducts a fixed number of points per omission. Method B adds twice the understated amount to the Adjusted Cost. Whichever is larger applies. The model already has the vehicle-to-subsystem-to-CI tree (EPBS) and a physical-node tree (PA). It holds no cost, material, process, fastener, tooling, make/buy or quantity data. None of the 90 S.1/S.3 rule paragraphs, the 53 PS paragraphs or the 19 Table PS-1/PS-2 rows is traced to a model element yet.">
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="e5c2f919-9199-4534-afb3-6817baaa0cce"
              definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:submissions-v1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="ae318eaa-e2b0-4a91-bbe7-53d230ca7123"
              definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="2052ab13-2238-4db2-b5b8-b610f7dfe938"
              definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="e19f877d-6b78-429b-a174-f9d027729e4c"
              definition="#abd36e5a-eaa7-47b8-8c54-0e0cdbabce20" value="COST"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="06597f03-d850-4962-a840-828b156a0c29"
              definition="#8418021d-4a12-4509-ab78-bf1394b884d6" value="[&quot;S.1 (static event points: Cost worth 100) FSAE-2027-V1:S.1:p002&quot;,&quot;S.3.1 Cost Event Objective FSAE-2027-V1:S.3.1:p001-p002&quot;,&quot;S.3.2 Cost Event Supplement FSAE-2027-V1:S.3.2:p001-p003&quot;,&quot;S.3.3 Cost Event Areas (report, event-day discussion, scenario) FSAE-2027-V1:S.3.3.1:p001-S.3.3.3:p002&quot;,&quot;S.3.4 Cost Report content and submission FSAE-2027-V1:S.3.4.1:p001-p007, S.3.4.2:p001&quot;,&quot;S.3.5 Bill of Materials hierarchy FSAE-2027-V1:S.3.5.1:p001-p006&quot;,&quot;S.3.6 Late Submission FSAE-2027-V1:S.3.6:p001&quot;,&quot;S.3.7 Cost Addendum FSAE-2027-V1:S.3.7.1:p001-S.3.7.6:p003&quot;,&quot;S.3.8 Cost Tables FSAE-2027-V1:S.3.8.1:p001, S.3.8.2:p001&quot;,&quot;S.3.9 Make versus Buy FSAE-2027-V1:S.3.9.1:p001-S.3.9.4:p001&quot;,&quot;S.3.10 Add Item Request FSAE-2027-V1:S.3.10.1:p001, S.3.10.2:p001&quot;,&quot;S.3.11 Public Cost Reports FSAE-2027-V1:S.3.11.1:p001, S.3.11.2:p001&quot;,&quot;S.3.12 Cost Report Penalties Process (Method A fixed points, Method B adjusted cost) FSAE-2027-V1:S.3.12.1:p001-S.3.12.5:p005&quot;,&quot;S.3.13 Event Day and Discussion FSAE-2027-V1:S.3.13.1:p001-S.3.13.4:p005&quot;,&quot;S.3.14 Cost Audit FSAE-2027-V1:S.3.14.1:p001, S.3.14.2:p001&quot;,&quot;S.3.15 Cost Scenario FSAE-2027-V1:S.3.15.1:p001-S.3.15.5:p001&quot;,&quot;S.3.16 Cost Event Scoring FSAE-2027-V1:S.3.16.1:p001-S.3.16.4:p001&quot;,&quot;PS.1.1 documents due by posted deadlines, procedures on Event Website FSAE-2027-V1:PS.1.1.1:p001, PS.1.1.2:p001&quot;,&quot;PS.1.2 submission definitions (Submission Date, Due Date, Cancellation Date, Late Submission, Not Submitted, Amount Late, Grounds for Removal, Reviewer) FSAE-2027-V1:PS.1.2.1:p001-PS.1.2.8:p002&quot;,&quot;PS.2.1 / PS.2.2 submission location, template use and single-file format FSAE-2027-V1:PS.2.1:p001, PS.2.2:p001-PS.2.2.4:p001&quot;,&quot;PS.3.1-PS.3.3 team responsibility, penalties, removal FSAE-2027-V1:PS.3.1.1:p001-PS.3.3.2:p003&quot;,&quot;Table PS-1 rows FSAE-2027-V1:TABLE-PS-1:p008 (Cost Report: S.3.4, form per S.3.4.2, file format per note 2, group Other), p009 (Cost Addendum: S.3.7, template per note 1, group none), p010 (Cost scenario deliverable, only when S.3.15.3 calls for it: group Other), p014-p015 (notes 1 and 2)&quot;,&quot;Table PS-2 group Other FSAE-2027-V1:TABLE-PS-2:p004 (-20 points per 24 h late; not submitted -> removed from the Cost event with zero score, per PS.3.2.2)&quot;,&quot;Formula SAE Cost Event Supplement (Event Website, external official document; sets BOM format, system categories, tooling and costing method)&quot;]"/>
