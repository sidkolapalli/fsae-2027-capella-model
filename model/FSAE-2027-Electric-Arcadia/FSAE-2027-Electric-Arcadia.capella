          <ownedRequirements xsi:type="Requirements:Requirement" id="136f68c3-ea71-4d33-a3f5-c6da5f5a6980"
              ReqIFIdentifier="FSAE2027:DD:DD-08" ReqIFLongName="Detect BSE faults and inhibit motor power"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Send BSE signals directly to a controller through an allowed path. Detect sensor/wiring faults persisting longer than one hundred milliseconds, treat them as implausibility and immediately stop all motor power. EV motor-controller power removal is sufficient; complete tractive-system deactivation is not required by this clause. For the analogue candidate detect open/short signals outside its actual operating range, with bias resistors ensuring open-circuit detection. Source example 0.5/4.5 V values are not adopted as hardware limits.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="b339b3cc-09f6-4861-b19f-2aea9d05c6c2"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="interpreted"/>
