          <ownedRequirements xsi:type="Requirements:Requirement" id="14a6b2d5-ebe7-4d05-9b73-f0f83412b4e1"
              ReqIFIdentifier="FSAE2027:VP:obligation:COCKPIT-PROTECTION" ReqIFLongName="FSAE2027:VP Contain the occupant and shield moving/sharp hazards"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Contain hips entirely within major chassis structure. With feet on pedals, feet/legs ahead of the front hoop stay inside/below structural tubing or equivalent in front/side views. Shield every moving suspension/steering part and sharp edge in the cockpit from the front hoop to a plane 100 mm behind pedals using solid material, including springs, dampers, rockers, antiroll bars, rack and column CV joints; make covers removable for mounting-point inspection. Protect the seat by keeping its lowest point no lower than the top of the lowest structural tube (or equivalent) in side view, or by a longitudinal class B side-impact tube below it.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="091558d8-d0e5-4cd5-9564-718d3185a5fc"
