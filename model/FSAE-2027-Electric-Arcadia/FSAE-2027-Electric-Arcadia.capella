                          id="8d40e879-c2a7-46f4-a13a-3fbb8f3456dc">
                        <bodies>Any required series contact opens or any GLV shutdown occurs. BMS IMD BSPD causes set the protective latch; other causes do not silently reset an existing latch.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="e584c37b-0701-34b9-91e0-c5bea8333e31" name="FSAE2027:SD Discharge to latched safe state"
                      triggerDescription="Residual voltage becomes low voltage with protective latch set"
                      guard="#1c5066b1-b788-3adb-91f6-e6eb815a01c9" source="#1cc62671-9d12-3f1c-81df-096bde72f3f7"
                      target="#38f3a24e-2a98-3c75-88bc-e5ca249da967">
                    <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                        id="1c5066b1-b788-3adb-91f6-e6eb815a01c9" name="FSAE2027:SD Discharge to latched safe state guard"
                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#83395866-03f1-3e2e-a2a2-719ca6509efb #2684c6fc-f4c7-3428-b6a0-d935acfcd626">
