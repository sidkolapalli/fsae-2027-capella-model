          <ownedRequirements xsi:type="Requirements:Requirement" id="7b619a9d-8915-4fd7-bbf5-cd6a647eb758"
              ReqIFIdentifier="FSAE2027:VP:obligation:BRAKE-REGEN" ReqIFLongName="FSAE2027:VP Keep regenerative braking optional and hydraulic actuation direct"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="For this EV the first 90 percent of pedal travel may regenerate without hydraulic actuation; it is an option. The remaining travel directly operates hydraulics, and regeneration may remain active. No 90 percent deadband or regeneration strategy is selected until the complete brake/powertrain design is reviewed.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="5548fa61-1c21-4080-a18c-1498e0a359b5"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
