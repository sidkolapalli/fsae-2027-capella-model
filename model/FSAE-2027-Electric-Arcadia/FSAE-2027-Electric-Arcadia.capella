            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="155916ca-93e0-47f4-94b5-610e0f012d19"
                definition="#eb315afb-4ef3-4767-a9a9-d5588017eb0d" value="unresolved"/>
