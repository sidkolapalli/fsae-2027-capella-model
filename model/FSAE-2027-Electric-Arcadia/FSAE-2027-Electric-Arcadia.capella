          <ownedRequirements xsi:type="Requirements:Requirement" id="329d84ea-df63-415d-af2b-2e39e3168168"
              ReqIFIdentifier="FSAE2027:VP:obligation:COCKPIT-OPENING" ReqIFLongName="FSAE2027:VP Keep the official cockpit opening gauge path accessible"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Pass the exact page 56 cockpit-opening gauge horizontally/parallel to ground, inserted vertically from above intervening structure/bodywork between hoops, allowing fore/aft translation, until both at least 25 mm below the side-impact top's lowest point and at most 320 mm above the cockpit's lowest point. Gauge drawing dimensions are 600 mm overall fore/aft span, front transverse 400 mm, rear transverse 350 mm,100 mm rear bevel offset, and 75/100 mm top-profile offsets; use the actual official outline rather than treating those dimensions as a rectangular substitute. Wheel/column/seat/padding removal is permitted, but retain the firewall; retain shifter/shift/clutch unless integral with the removed wheel. Routing cannot obstruct the gauge. In practice the column remains and may be maneuvered around, never around fixed supports; an optional front-center column slot is allowed.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="239c3f81-b37f-4794-b836-b3fd7a5b7307"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
