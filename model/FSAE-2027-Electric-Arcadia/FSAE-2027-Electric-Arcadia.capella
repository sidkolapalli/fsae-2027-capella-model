          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#db1bf125-5330-3fef-913d-5365cd9aab7f #052ba2b8-5209-3aa1-99ce-51eb55d39957 #ef1f0d00-f007-3a47-8bf7-bb723b1b2c90 #fbd35ccd-e300-309b-a64f-30b004a87f46 #c3eda33c-5bf7-30ed-a651-da90fa8e2f38 #e33dae75-9a3b-3822-b382-372f6c891a37 #28b391ad-021f-39ba-ac10-fb4bafe83ae3 #87dff644-a41a-3feb-a7bd-457120b567bd #a38b781a-d3b4-3211-869b-3828344fa293 #4aa2525e-f7cd-38a6-a501-c6687cc41946 #94a3d826-a612-3513-8eb3-df5805639f86 #2904fe19-f7ed-30f3-9664-f8e37fe45fe8 #ed2109e2-36e4-3bfe-ad7d-3586083ae889 #53e89cde-5638-3ca6-9f89-f868f7647f38 #73aa2539-f087-3106-a899-6773dbe53099 #cd5566c8-0d9f-3d3d-aa31-1cd3da537f6c">
