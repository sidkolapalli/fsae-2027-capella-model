          <ownedRequirements xsi:type="Requirements:Requirement" id="6836305e-3d2b-4c9b-bc1d-ed470a2bb7d7"
              ReqIFIdentifier="FSAE2027:VP:obligation:BOTS" ReqIFLongName="FSAE2027:VP Open and retain the direct overtravel shutdown contact"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Travel beyond the normal brake-pedal range operates BOTS. Use a mechanical SPST two-position push-pull, push-rotate or flip switch that holds OFF; OFF opens the EV shutdown circuit. The driver cannot reset it. Implement the circuit with analog components, excluding programmable logic/ECU/similar digital controllers. The model reuses the shutdown slice's physical BOTS contact rather than adding a parallel or duplicate contact.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="bd0c4083-510f-42e0-9be0-8e1ef128d937"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="dc7ff559-8b12-453a-939e-f7ab7d27002a"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
