          <ownedRequirements xsi:type="Requirements:Requirement" id="8eb5a58e-262c-4a26-9ce3-930ee90afa32"
              ReqIFIdentifier="FSAE2027:VP:obligation:FRONT-STACK" ReqIFLongName="FSAE2027:VP Place the attenuator and AIP in a protected load path"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Locate the impact attenuator ahead of the front bulkhead with an anti-intrusion plate between them. Both attenuator-to-AIP and AIP-to-bulkhead attachments carry transverse and vertical loads from off-axis impacts.">
