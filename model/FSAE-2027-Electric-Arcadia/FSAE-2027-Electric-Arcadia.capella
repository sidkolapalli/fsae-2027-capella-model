          <ownedRequirements xsi:type="Requirements:Requirement" id="67453764-591a-4288-98c2-ff8c0d0ffcd2"
              ReqIFIdentifier="FSAE2027:VP:obligation:BRAKE-CORE" ReqIFLongName="FSAE2027:VP Maintain hydraulic stopping under a circuit failure"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Provide brakes on all four wheels operated by a single control and able to lock all four. Use two independent hydraulic circuits; leakage/failure at any point leaves effective braking on at least two wheels. Each circuit has a separate fluid reserve via separate reservoirs or an OEM-style reservoir. A single brake on a limited-slip differential is permitted, not selected. Prohibit brake-by-wire and unarmored plastic lines. Use scatter shielding against drivetrain failure and minor collisions. Sprung brake components in side view do not project below the chassis lower surface. Treat every brake-system fastener as critical under T.8.2.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="b55c2e39-9f2a-4b2d-b8fa-55053a3e068e"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="e180d6e8-a815-4834-98c8-87984238b84c"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="de85970e-0e5e-49ba-b5b1-f6e6e51260d5"
                definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:vehicle-protection-v1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="dc921508-3d52-4db1-8528-5681686f8318"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="bounded_source_interpretation_requires_design_review"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="6ad9b82a-34bd-43ea-a8ef-0717b40d82c5"
                definition="#7d047b7b-d5c2-4581-a36c-9ea870bbae18" value="allocated_candidate_design"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="6b704540-419b-4af0-9a7d-6260a1d4e56c"
                definition="#2386599d-283f-4676-a72d-71e2f2664451" value="not_verified"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="79e3c38f-87bc-4119-97c0-d5a879b99ddb"
                definition="#eb315afb-4ef3-4767-a9a9-d5588017eb0d" value="unresolved"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="f2fcf252-ebaf-453f-a10b-2b986b9e88ca"
                definition="#93aadbc9-246e-4a0b-9571-805e6660044c" value="[&quot;Circuit wheel assignment and differential versus wheel-brake hardware remain unresolved; a common electronics/regen path cannot replace hydraulic braking.&quot;,&quot;Separate reserves in an OEM-style housing do not waive hydraulic circuit independence.&quot;]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="3dcd4a0e-9f08-4db5-adee-fce500a34ad7"
