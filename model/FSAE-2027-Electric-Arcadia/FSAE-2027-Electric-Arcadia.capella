                definition="#e74563e6-54e4-4b1e-9564-bbeaadb5f842" value="braking sensor / driver-demand monitor / powertrain"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="27234581-4412-4106-8325-924a7953bb4c"
                definition="#24dab7e7-9bdb-4a7d-a787-ade81adc5a7f" value="inspection_review_and_fault_injection"/>
