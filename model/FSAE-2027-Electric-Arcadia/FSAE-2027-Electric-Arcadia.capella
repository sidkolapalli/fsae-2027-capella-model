                definition="#cd92da3c-dabc-4352-8406-10793ad92c60" value="Provide two four-millimetre shrouded banana jacks, neither red nor black, labelled CS+ and CS-. They must be directly accessible during active inspection, either on the vehicle or through an adaptor/breakout. This candidate models vehicle-mounted points; final placement and permissible colour selection remain unresolved."/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="cf1bd23d-8156-43e9-a983-49c4ac437196"
                definition="#9ef6f6e2-95cf-48f9-bb1a-0dc6504d8d99" value="[&quot;Chosen vehicle-mounted candidate; adaptor/breakout is the source alternative.&quot;]"/>
