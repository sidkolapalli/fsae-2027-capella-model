          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="39459328-4c82-49dd-8f96-8c381f199071"
              definition="#6f4fcadb-4e40-4396-8b81-7a25e5d1e745" value="[&quot;9a8199d8-7e4c-49c3-9fa0-45b2cf896855&quot;]"/>
