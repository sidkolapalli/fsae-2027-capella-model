          <ownedRequirements xsi:type="Requirements:Requirement" id="16f10aaa-39a4-400a-9d86-33c61b062f1a"
              ReqIFIdentifier="FSAE2027:VP:obligation:FRONT-HOOP" ReqIFLongName="FSAE2027:VP Constrain front-hoop material and geometry"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Use closed metal tubing of the prescribed class for a front hoop running up from the bottom frame member on one side and down to the bottom member on the other. Multiple pieces require correct triangulation. Its top is at least as high as the steering-wheel top in every angular position. Its rear surface is at most 250 mm forward of the wheel rim's forwardmost surface, measured horizontally on centerline with steering straight. Above the upper side-impact structure, side-view inclination is strictly below 20 degrees from vertical. A nonsteel hoop has an accessible 4 mm inspection hole. Avoid concave top-perimeter sections as the source recommendation.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="569e95aa-6403-4438-98bf-19bf0022b4a9"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
