                definition="#2386599d-283f-4676-a72d-71e2f2664451" value="not_verified"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="1afbf34a-4ece-4b3c-8508-7ce099f94531"
                definition="#a6f8b280-f501-44d6-b974-e0c0e356134b" value="not_available"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="3e1728cc-aede-492e-81bd-6c1698e805c4"
                definition="#41afa17f-634c-41e7-979f-4215631eb35d" value="not_claimed"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="08a51238-b85e-44e2-b549-92458d12c254"
                definition="#cd92da3c-dabc-4352-8406-10793ad92c60" value="Send BSE signals directly to a controller through an allowed path. Detect sensor/wiring faults persisting longer than one hundred milliseconds, treat them as implausibility and immediately stop all motor power. EV motor-controller power removal is sufficient; complete tractive-system deactivation is not required by this clause. For the analogue candidate detect open/short signals outside its actual operating range, with bias resistors ensuring open-circuit detection. Source example 0.5/4.5 V values are not adopted as hardware limits."/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="83dd20af-0e21-4c56-b991-ea962c9b5147"
                definition="#9ef6f6e2-95cf-48f9-bb1a-0dc6504d8d99" value="[&quot;Candidate analogue BSE. Digital BSE requirements and its form applicability remain unallocated.&quot;]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="9aa34ab4-6ef7-4b5f-8db8-6b20ce230939"
                definition="#ca60b341-b6be-489d-a1d0-6e0419f9d48e" value="[{&quot;quantity&quot;:&quot;BSE fault persistence&quot;,&quot;value&quot;:100,&quot;unit&quot;:&quot;ms&quot;,&quot;operator&quot;:&quot;>&quot;},{&quot;quantity&quot;:&quot;illustrative analogue fault range&quot;,&quot;lower&quot;:0.5,&quot;upper&quot;:4.5,&quot;unit&quot;:&quot;V&quot;,&quot;role&quot;:&quot;source example only&quot;}]"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="e1355ba2-0372-43ac-a1da-429a0f43a356"
