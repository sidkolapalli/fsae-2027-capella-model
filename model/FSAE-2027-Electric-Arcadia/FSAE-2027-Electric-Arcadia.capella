          <ownedRequirements xsi:type="Requirements:Requirement" id="d8bddbcf-1c6c-4d67-ae74-bf192ca38ff2"
              ReqIFIdentifier="FSAE2027:VP:obligation:BRAKE-LIGHT" ReqIFLongName="FSAE2027:VP Signal braking with the required rear visibility and geometry"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Provide a rear brake lamp plainly visible in very bright sunlight. It is red on black, rectangular/triangular/near-round with lit area at least 15 cm^2, vertically between wheel centerline and driver's shoulder and approximately on lateral centerline. Undiffused LEDs are at most 20 mm apart; a single LED line is at least 150 mm long. These alternatives do not override minimum lit area/visibility.">
