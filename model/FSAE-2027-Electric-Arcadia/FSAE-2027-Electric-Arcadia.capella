                          id="5746d049-bc19-4f78-b540-f84b8f4f8f88">
                        <bodies>TS reaches T.9.1.2 low voltage within 5 s and a BMS IMD BSPD protective trip is latched; remain disabled.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="2ce4e41f-4b3a-3db8-b57a-4ea9613d93fa" name="FSAE2027:SD Discharge to ordinary open state"
                      triggerDescription="Residual voltage becomes low voltage without protective latch"
                      guard="#795c9f97-1b46-3002-9b1c-56da6e7d05b9" source="#1cc62671-9d12-3f1c-81df-096bde72f3f7"
                      target="#97ecc430-9fab-3093-a9c1-7bcc4f6021ce">
                    <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
