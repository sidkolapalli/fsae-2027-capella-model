                          id="5c789d7e-5f94-4cb8-b2e6-56419859f77b">
                        <bodies>Isolation and precharge coil drive absent; tractive battery current interrupted; no applied motor torque; cell balancing inhibited. Residual TS voltage is discharged to T.9.1.2 low voltage within 5 s after opening. Monitoring remains required while charger-connected.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </stateInvariant>
                  </ownedStates>
