                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#83395866-03f1-3e2e-a2a2-719ca6509efb #2684c6fc-f4c7-3428-b6a0-d935acfcd626">
                      <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation"
                          id="0486cd53-bd96-4792-aeda-cc025f806c32" ReqIFLongName="satisfy"
                          relationType="#1d88e38b-67fc-4c43-a2bb-bbc1b2db3e22" source="#37d432bb-6da5-3629-af85-ac569c5eaeae"
                          target="#f975dd7c-b5d4-48fe-b130-3bbbc0e6abd1"/>
                      <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation"
                          id="bcc81d79-edae-45ea-89fe-526f66063a40" ReqIFLongName="satisfy"
                          relationType="#1d88e38b-67fc-4c43-a2bb-bbc1b2db3e22" source="#37d432bb-6da5-3629-af85-ac569c5eaeae"
                          target="#2aee5fa0-ab4f-49c3-9641-796e4b628721"/>
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="8f5ddebd-89a5-42c2-92e0-92e8a3d453b9">
                        <bodies>All protective faults cleared AND manual reset by a person directly at the vehicle, inaccessible to driver reactivation; no remote or automatic reset. This transition keeps TS disabled; it is not an energization transition.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="78f46c1c-3d9e-38d5-a44c-851a027e23ba" name="FSAE2027:SD Controls cannot bypass protective latch"
                      triggerDescription="Unpermitted reset or reactivation attempt"
                      guard="#1b3b0388-195c-30eb-909b-39c8d96d0ca6" source="#38f3a24e-2a98-3c75-88bc-e5ca249da967"
                      target="#38f3a24e-2a98-3c75-88bc-e5ca249da967">
                    <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                        id="1b3b0388-195c-30eb-909b-39c8d96d0ca6" name="FSAE2027:SD Controls cannot bypass protective latch guard"
                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#83395866-03f1-3e2e-a2a2-719ca6509efb #2684c6fc-f4c7-3428-b6a0-d935acfcd626">
                      <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation"
                          id="6ffa1974-15b3-44c7-af6f-2b4375f9bfab" ReqIFLongName="satisfy"
                          relationType="#1d88e38b-67fc-4c43-a2bb-bbc1b2db3e22" source="#1b3b0388-195c-30eb-909b-39c8d96d0ca6"
                          target="#2aee5fa0-ab4f-49c3-9641-796e4b628721"/>
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="5e07b21c-008a-4c51-9409-16202662e6f9">
                        <bodies>TSMS or emergency-button toggles, driver controls, remote requests, GLV power cycling, or uncleared faults cannot release the protective latch.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                </ownedRegions>
              </ownedStateMachines>
