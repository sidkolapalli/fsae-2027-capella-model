          id="4ff54393-6928-3675-b9d6-03201a156db2" name="FSAE2027:VP Maintain hydraulic stopping under a circuit failure verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#ebc9aaa8-e324-3fb8-b6f4-f579381cd5af #5f8c038c-45d0-3222-b9bd-626d4f7b03e3 #58007ce7-f7fe-3dd5-bdb5-9a7ce2676c99 #39d57d1b-64a4-307a-8b29-a74d91f68f8f #c258e9c9-2f1c-300e-b66e-a42153e5b315 #4b8c16a6-6bdc-345c-9983-b7ce947ff5cd #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4 #bcf5f1aa-ea67-3136-8d58-d8dd56ed05b6 #7e2ba09c-b62d-3481-bd81-cc6f21461fdc #6b3ab259-c76e-39d2-80b9-aa6deeb3a38b #1e1e4271-df29-3777-8051-9edda6febb09 #9ee90529-eeda-3c52-b39d-f03ccfe05a71 #01c02a0b-3932-396d-8908-75fda0d0deea #06460514-7d88-334f-8765-fead5aa9119d #70953986-669c-3e88-a395-a7b43e4c1aeb #a8689c03-c0a0-330d-a31f-a2e9b1ae3a54 #80cc87fd-39fb-32b9-9feb-29eab38b573c #413b6304-7285-3e31-8555-9c471b832ea4 #0dc98a19-da80-3096-b456-a79a0d7f3ea8 #f9469550-14b0-3c62-8a1b-5756ec7e0c03 #cf86bfb7-c12a-3ec9-9fa3-d5801b29e712 #aa413183-02f2-3b02-a297-2eff941ad32a #3695d5b3-3026-3846-a80a-487e0d7aed59 #99f21a67-562d-35cc-96d1-9f4fd4e7e278 #69da8881-ce08-3a6a-b389-a487f1585381 #fa9da9ed-7116-30f7-b420-15b41a08c4fb #0d27e4e5-a014-32a8-8fc1-7d667f1597f3 #94310ef2-a1b2-3a96-91b5-310b25483cf7 #3d6e50b3-abbb-3f95-ac89-b0fd65e12bc3 #7bca46eb-0b02-3055-96a8-d1391af8f29c #82ae7460-5fdf-3d9c-8ca0-3b545b9286cd #cf77d0b8-86c3-30b6-a1f3-cf87a8629e8b #194892ad-f591-3409-b9ee-c4cc743f512b #1777047a-14dc-3c15-a387-2c7f13fd86aa #d166ae5c-771d-3a67-885e-a62a1936aa19">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="c9714200-b86a-43a6-92b7-839b8c39e7a0">
          <bodies>Inspect single mechanical control, hydraulic separation/reserves/materials, critical fasteners, shielding and sprung packaging. Demonstrate four-wheel lock and inject every credible leak/failure to prove effective braking on at least two wheels.
Conditions/alternatives: Circuit wheel assignment and differential versus wheel-brake hardware remain unresolved; a common electronics/regen path cannot replace hydraulic braking. Separate reserves in an OEM-style housing do not waive hydraulic circuit independence.
Open choices: Circuit split, reservoirs, cylinders/calipers/differential, lines, shields, fasteners and performance evidence TBD.
Dependencies outside this bounded interpretation: T.5.2, T.8.2
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="bd168481-8a58-399e-a2d2-7895d3cf8243" name="FSAE2027:VP Protect mechanical pedal strength and operation verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#9b3e192f-3521-316f-8bf0-e48458b0fbd2 #abe4bd66-8c9a-3148-b9a0-eeac1526abd4 #dba98e8d-7e7b-3016-a38f-be0fa578f2a7 #038d55a2-c6f0-3222-a40c-f2e40626272a #c258e9c9-2f1c-300e-b66e-a42153e5b315 #4b8c16a6-6bdc-345c-9983-b7ce947ff5cd #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4 #ebc9aaa8-e324-3fb8-b6f4-f579381cd5af #5f8c038c-45d0-3222-b9bd-626d4f7b03e3 #58007ce7-f7fe-3dd5-bdb5-9a7ce2676c99 #39d57d1b-64a4-307a-8b29-a74d91f68f8f #bcf5f1aa-ea67-3136-8d58-d8dd56ed05b6 #7e2ba09c-b62d-3481-bd81-cc6f21461fdc #6b3ab259-c76e-39d2-80b9-aa6deeb3a38b #1e1e4271-df29-3777-8051-9edda6febb09 #9ee90529-eeda-3c52-b39d-f03ccfe05a71 #01c02a0b-3932-396d-8908-75fda0d0deea #06460514-7d88-334f-8765-fead5aa9119d #70953986-669c-3e88-a395-a7b43e4c1aeb #a8689c03-c0a0-330d-a31f-a2e9b1ae3a54 #80cc87fd-39fb-32b9-9feb-29eab38b573c #413b6304-7285-3e31-8555-9c471b832ea4 #0dc98a19-da80-3096-b456-a79a0d7f3ea8 #f9469550-14b0-3c62-8a1b-5756ec7e0c03 #cf86bfb7-c12a-3ec9-9fa3-d5801b29e712 #aa413183-02f2-3b02-a297-2eff941ad32a #3695d5b3-3026-3846-a80a-487e0d7aed59">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="6daf02c1-bee8-45a1-b2b3-49b073b60fd5">
          <bodies>Review selected material/process, load path and hazards from non-loadbearing failures. Substantiate the minimum strength and inspection pedal-test conditions with documented test/analysis evidence, not an invented universal design margin.
Conditions/alternatives: Material and fabrication route are coupled alternatives; fabricated titanium is not an allowed listed option.
Open choices: Pedal fabrication/material, box/mount/adjustment, human force envelope and proof evidence TBD.
Dependencies outside this bounded interpretation: 
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="22997860-8222-3b72-8084-fadd1dce4214" name="FSAE2027:VP Keep regenerative braking optional and hydraulic actuation direct verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#ebc9aaa8-e324-3fb8-b6f4-f579381cd5af #5f8c038c-45d0-3222-b9bd-626d4f7b03e3 #58007ce7-f7fe-3dd5-bdb5-9a7ce2676c99 #39d57d1b-64a4-307a-8b29-a74d91f68f8f #c258e9c9-2f1c-300e-b66e-a42153e5b315 #4b8c16a6-6bdc-345c-9983-b7ce947ff5cd #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4 #99f21a67-562d-35cc-96d1-9f4fd4e7e278 #69da8881-ce08-3a6a-b389-a487f1585381 #fa9da9ed-7116-30f7-b420-15b41a08c4fb #0d27e4e5-a014-32a8-8fc1-7d667f1597f3 #94310ef2-a1b2-3a96-91b5-310b25483cf7 #3d6e50b3-abbb-3f95-ac89-b0fd65e12bc3 #7bca46eb-0b02-3055-96a8-d1391af8f29c #82ae7460-5fdf-3d9c-8ca0-3b545b9286cd">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="a00acc7e-4c58-4b02-9e2f-da0e0b941e31">
          <bodies>Decide whether and how regen is used; sweep pedal travel and prove direct hydraulic actuation in the remaining range even with disabled/failed regeneration. Review the referenced EV regenerative braking and conflict safeguards.
Conditions/alternatives: If regeneration is used, coordinate the low-speed inhibition and brake/accelerator plausibility in the separately owned driver-demand slice.
Open choices: Regen adoption, pedal transition, hydraulic timing and cross-slice interface contract TBD.
Dependencies outside this bounded interpretation: EV.4.6, EV.3.3.3, EV.4.7
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="2fa85b8d-259e-3796-bdf1-34b471338828" name="FSAE2027:VP Open and retain the direct overtravel shutdown contact verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#c8b6e696-e994-3b05-a875-59b5049b7b6b #56c09b47-e799-38f5-bf14-b5721cec8360 #1df38e00-4761-393e-8268-289d053ed4b6 #1c822ad1-e2b0-3c0d-aa97-942084cd24cb #0e4d4710-6e1e-38ae-8ca9-b3b0fcc3547d #2ef75ab9-8556-3a33-8cd5-b5fd8dddf03e #d5bb3a8a-e210-385a-b680-39242a42c604 #8e0dfe8c-3fa4-3f31-9c3e-9bed59ea0962 #9b3e192f-3521-316f-8bf0-e48458b0fbd2 #abe4bd66-8c9a-3148-b9a0-eeac1526abd4 #dba98e8d-7e7b-3016-a38f-be0fa578f2a7 #038d55a2-c6f0-3222-a40c-f2e40626272a #c258e9c9-2f1c-300e-b66e-a42153e5b315 #4b8c16a6-6bdc-345c-9983-b7ce947ff5cd #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="304b6c65-53d4-48e3-8c94-20d4227b78fa">
          <bodies>Force brake overtravel, inspect mechanical SPST/contact holding and analog/direct wiring, prove the installed series shutdown opens and verify no seated/restrained driver can reset the contact.
Conditions/alternatives: Human-driven EV: EV.8.2.2 applies; the published IC reference is retained as nonapplicable to this electric baseline.
Open choices: Overtravel threshold, normal travel/adjustment limits, switch rating/location and reset-access geometry TBD.
Dependencies outside this bounded interpretation: EV.8.2.2
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="5695ebcc-56e8-3fc9-8ba3-060ef98b86ed" name="FSAE2027:VP Signal braking with the required rear visibility and geometry verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#d5ee1acf-5927-30ae-8ab1-9d35e6911cbe #5edf1353-f78e-3dec-95df-07a7286a0135 #4cb89a15-09a6-32a1-a8aa-6fb5238930e6 #8c87e747-0d6e-3f1e-b597-bdf87e14efd8 #e1d19f5c-ef48-3b7f-a6c2-880c69c8b4bf #8778988b-a90d-3b75-b298-8d873da8ef80 #1c234d20-b78f-3bff-b8ce-a902149f5aa6 #b18c6a0f-4f50-34f5-984a-64a765c86cda #ebc9aaa8-e324-3fb8-b6f4-f579381cd5af #5f8c038c-45d0-3222-b9bd-626d4f7b03e3 #58007ce7-f7fe-3dd5-bdb5-9a7ce2676c99 #39d57d1b-64a4-307a-8b29-a74d91f68f8f #c258e9c9-2f1c-300e-b66e-a42153e5b315 #4b8c16a6-6bdc-345c-9983-b7ce947ff5cd #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="744fc197-7933-432b-959e-97ff3daa3cb9">
          <bodies>Inspect color/background, shape/lit area and installation heights/centerline. Apply the conditional LED spacing/line-length checks and demonstrate visibility from rear in very bright sunlight with the chosen brake activation logic.
Conditions/alternatives: Lamp shape, LED/diffuser technology, brightness and trigger circuit remain unresolved.
Open choices: Exact lamp, wiring/activation, diffuser/LED layout and sunlight visibility evidence TBD.
Dependencies outside this bounded interpretation: 
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
