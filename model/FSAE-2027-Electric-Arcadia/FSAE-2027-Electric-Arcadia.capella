              definition="#e74563e6-54e4-4b1e-9564-bbeaadb5f842" value="driver-demand monitoring / powertrain inhibit enforcement"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="79113c30-7a56-41c7-973c-699a2acdc850"
              definition="#24dab7e7-9bdb-4a7d-a787-ade81adc5a7f" value="inspection_review_and_fault_injection"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="b67a6edd-2f7a-4972-922a-d24b73f69ce6"
              definition="#a6f8b280-f501-44d6-b974-e0c0e356134b" value="not_available"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="81be8877-1497-4e8a-96f5-476f073ab230"
              definition="#41afa17f-634c-41e7-979f-4215631eb35d" value="not_claimed"/>
          <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="e6b77891-8f6c-4719-afc5-086d3da26daf"
              definition="#cd92da3c-dabc-4352-8406-10793ad92c60" value="Treat deviation greater than ten percent pedal travel, sensor failures and wiring failures as APPS implausibility. If implausibility persists longer than one hundred milliseconds, stop all motor power immediately. In an EV, stopping power through the motor controller is sufficient; opening the shutdown circuit is not required by this APPS clause. Analogue open/short faults outside the actual operating range must be detected using pull-up/down circuitry. The example 0.5/4.5 V values are not adopted as universal design thresholds. Proposing a deviation threshold above ten percent requires the stated form justification and approval review."/>
