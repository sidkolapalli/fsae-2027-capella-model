            <ownedRelations xsi:type="Requirements:InternalRelation" id="443f2dc9-c4e5-4e81-a5c5-1eaecde38290"
                ReqIFLongName="derive" relationType="#809594af-637b-44eb-ab1a-592b3c96040b"
                source="#7d3faed0-b9c9-45da-855b-76902f999053" target="#1528e3fb-7f20-4d38-b8d3-a5ed56e3413d"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="2e7752e7-80f9-4a02-b65a-e21746714089"
              ReqIFIdentifier="FSAE2027:VP:obligation:IA-ATTACHMENT" ReqIFLongName="FSAE2027:VP Constrain attenuator attachment and position"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Document IA attachment in SES. Standard/custom foam or honeycomb attaches by bonding; custom other construction may bond, weld or bolt. Bonds satisfy F.5.5 and shear strength strictly exceeds every applicable threshold:95 kN for foam,38.5 kN for honeycomb, and the maximum compressive force for a custom IA. Bond all foam surface; only precrushed honeycomb area counts for bond equivalence. Welds may be continuous/interrupted; interrupted ratio is at least 1:1 and each length is strictly greater than 25 mm. Bolting directly to primary structure uses at least eight critical fasteners of at least 8 mm or 5/16 in diameter, center separation at least 50 mm and each attachment 15 kN pullout/tearout/bending. Bottom leading edge is at most 175 mm above the lower side-impact structure's lowest bottom point. A custom IA has an area at least 200 mm long and 200 mm wide intersecting a ground-parallel plane at or below that 175 mm limit. Center IA laterally; standard honeycomb orientation is 200 mm wide by 100 mm high; standard foam may be lateral or vertical.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="cba443e7-e314-4b87-92da-5b9a0e6ef687"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
