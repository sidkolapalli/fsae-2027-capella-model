      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="a9f2276a-3b02-3591-a5e8-74ef8eea0ebc" name="FSAE2027:SD semantic structure v2 APPLIED"
          summary="Shutdown leaf endpoints repaired. Exchange/port realization phase 36 and physical verification remain pending; NOT_VERIFIED."/>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="08439dd5-e9e9-36bc-ae54-e434bfe47c02" name="FSAE2027:SD semantic repair v2 APPLIED"
          summary="Native leaf endpoints and exchange/port realizations repaired. Shared bootstrap normalization and physical verification remain separate; NOT_VERIFIED."/>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="1b1ba7d2-3a7d-42c3-8aa7-4e4c6d7889d2" name="FSAE2027:DD native semantics repair v2 APPLIED"
          summary="DD exchanges use leaf endpoints and native perspective/port realizations; independent monitor machines each have one initial state. Source and pre-existing exchange/port/state IDs preserved. Verification remains NOT VERIFIED."/>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="acb55af8-c890-36ed-a2d9-67914ede93ff" name="FSAE2027:VP Independent brake circuits and unresolved wheel split INVARIANT"
          summary="NOT_VERIFIED. Candidate verification or unresolved design obligation; no test evidence or compliance conclusion."
          constrainedElements="#7e2ba09c-b62d-3481-bd81-cc6f21461fdc #80cc87fd-39fb-32b9-9feb-29eab38b573c #69da8881-ce08-3a6a-b389-a487f1585381 #06460514-7d88-334f-8765-fead5aa9119d #aa413183-02f2-3b02-a297-2eff941ad32a #7bca46eb-0b02-3055-96a8-d1391af8f29c">
        <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="19a59f1c-5cbc-4d3b-9c41-eed06e2c731e"
            ReqIFLongName="satisfy" relationType="#2e468c6c-54f1-46f0-b2f9-9cc10213ce71"
            source="#acb55af8-c890-36ed-a2d9-67914ede93ff" target="#fb921c0f-bc85-4ae7-8fae-15e57a6de917"/>
        <ownedExtensions xsi:type="CapellaRequirements:CapellaOutgoingRelation" id="6b96dc31-a3b2-4cc1-835d-42a17ebc46da"
            ReqIFLongName="satisfy" relationType="#2e468c6c-54f1-46f0-b2f9-9cc10213ce71"
            source="#acb55af8-c890-36ed-a2d9-67914ede93ff" target="#a7abbfaa-60dd-422e-a828-2fae84a0ab98"/>
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="70342c2c-db33-4318-aeae-87ff966cffc8">
          <bodies>One mechanical pedal operates two independent hydraulic circuits with distinct fluid reserves. Any leak/failure anywhere leaves effective braking on at least two wheels. A/B wheel mapping, OEM/shared housing internal separation, any allowed limited-slip differential brake and physical tubing remain TBD. The shared wheel-braking behavior is an abstract boundary, not a junction combining hydraulic circuits. No brake-by-wire path or regenerating drive replaces direct hydraulic braking.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="4e3b54fa-526d-3479-b134-fc343d8b50ad" name="FSAE2027:VP Material-dependent architecture alternatives TBD"
          summary="NOT_VERIFIED. Candidate verification or unresolved design obligation; no test evidence or compliance conclusion."
          constrainedElements="#ed2109e2-36e4-3bfe-ad7d-3586083ae889 #73aa2539-f087-3106-a899-6773dbe53099 #cd5566c8-0d9f-3d3d-aa31-1cd3da537f6c #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1 #dfc544c7-48fa-3561-a2e6-30ce6007c419 #571541be-6a5f-3daa-81d8-c6aaed41d551 #d326dc8a-b6ce-329b-87d9-7ff7f7576a52 #c3eda33c-5bf7-30ed-a651-da90fa8e2f38 #28b391ad-021f-39ba-ac10-fb4bafe83ae3 #87dff644-a41a-3feb-a7bd-457120b567bd #0dc8a429-72f3-3496-9ca1-cf02f545968b #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92 #ed0edd9f-e0b3-32fd-887f-b46ff04ed256 #06a81ec3-89fa-3a4d-b54d-8de24e9060b3 #8a7a6d43-e5de-33d0-b8fb-7e59f88b087b #4105e544-64b9-30bc-8675-e227c7a85623 #b925e0db-fbab-3d65-9bbd-72354742d1cf #6eea27b1-3e56-3a06-93c1-4bf9204eae65 #01d6566b-71e8-3aa8-b7f2-7145332325e7 #1ce1426e-0127-3121-bacb-03134e3b0b46 #51334761-7870-3b7c-a78f-a6c74fd93ebe #c258e9c9-2f1c-300e-b66e-a42153e5b315 #2a4bab68-e686-37ff-8448-0c0397e28caa #917d1835-b56e-3d83-a3ed-058089d41de4 #9ee90529-eeda-3c52-b39d-f03ccfe05a71 #06460514-7d88-334f-8765-fead5aa9119d #70953986-669c-3e88-a395-a7b43e4c1aeb #f9469550-14b0-3c62-8a1b-5756ec7e0c03 #aa413183-02f2-3b02-a297-2eff941ad32a #3695d5b3-3026-3846-a80a-487e0d7aed59 #94310ef2-a1b2-3a96-91b5-310b25483cf7 #7bca46eb-0b02-3055-96a8-d1391af8f29c #82ae7460-5fdf-3d9c-8ca0-3b545b9286cd #0e4d4710-6e1e-38ae-8ca9-b3b0fcc3547d #d5bb3a8a-e210-385a-b680-39242a42c604 #8e0dfe8c-3fa4-3f31-9c3e-9bed59ea0962 #e1d19f5c-ef48-3b7f-a6c2-880c69c8b4bf #1c234d20-b78f-3bff-b8ce-a902149f5aa6 #b18c6a0f-4f50-34f5-984a-64a765c86cda">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="f8aded71-b1b6-423d-b009-a342ee935947">
          <bodies>Select and justify tube-frame, monocoque or hybrid; steel/aluminum/composite member applications; AIP material/attachment; standard/custom IA and construction; side-impact proof method; harness posture/type; pedal fabrication/material; optional regeneration; circuit split and wheel hardware. Until reviewed, retain all conditional source obligations. The model contains candidate responsibility/equipment boundaries and does not instantiate mutually exclusive material alternatives as built hardware.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="40d9b0fc-3da3-39fe-a364-e3165be3d478" name="FSAE2027:VP Bounded slice dependencies and exclusions OPEN"
          summary="NOT_VERIFIED. Candidate verification or unresolved design obligation; no test evidence or compliance conclusion."
          constrainedElements="#ed2109e2-36e4-3bfe-ad7d-3586083ae889 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #dfc544c7-48fa-3561-a2e6-30ce6007c419 #c3eda33c-5bf7-30ed-a651-da90fa8e2f38 #0dc8a429-72f3-3496-9ca1-cf02f545968b #ed0edd9f-e0b3-32fd-887f-b46ff04ed256 #4105e544-64b9-30bc-8675-e227c7a85623 #01d6566b-71e8-3aa8-b7f2-7145332325e7 #c258e9c9-2f1c-300e-b66e-a42153e5b315 #9ee90529-eeda-3c52-b39d-f03ccfe05a71 #f9469550-14b0-3c62-8a1b-5756ec7e0c03 #94310ef2-a1b2-3a96-91b5-310b25483cf7 #0e4d4710-6e1e-38ae-8ca9-b3b0fcc3547d #e1d19f5c-ef48-3b7f-a6c2-880c69c8b4bf">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="9d350349-c7af-400b-8693-2c9dfc220e35">
          <bodies>Complete referenced structural equivalence/material tests, bulkhead/support/bracing/joint rules, cockpit internal section and thermal protection, all harness mounting rules, fastener rules, EV grounding/outboard-motor conditions, drivetrain scatter protection, official event-site anthropometry/standard IA/FAQ, and cross-slice regenerative braking/plausibility interfaces. Selected source clauses only; full V/F/T/event coverage and any compliance conclusion remain open.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="5caf3045-0acf-3914-be88-f01bb534b332" name="FSAE2027:VP Shared bootstrap aggregate interfaces require leaf mapping OPEN"
          summary="NOT_VERIFIED. Candidate verification or unresolved design obligation; no test evidence or compliance conclusion."
          constrainedElements="#a0339dd6-74af-419f-9139-fb1f8e87288b #41c2de73-7b4b-4cd0-b11a-daf449b25c9d #a30e8073-7d77-45b1-9a59-321b5d4815d2 #d347453d-cc4b-45ea-8763-184b50ce7bf3 #4d47531a-8168-4b3c-b1a2-f89cc67ee94f #ccba30ec-cb0c-4786-8fad-0bb208fff0a6 #95c13be3-a90d-4c94-831b-259edec31f60 #6c213568-4d8a-486e-9fd2-5f7410202e22 #0b87c789-3b50-4185-a5f3-24dd0c4fc806 #e08a8212-90d2-41a2-a2e2-3ef01ef80d6c #c24f307b-f18c-4f02-9506-c69a4960bdae #b0a31ace-4e7b-4568-b6ce-732bbbbce0a9 #cba73ba0-9025-4a2d-adb6-3c27d206aaa2 #aabfa1e8-0da5-4a61-a4e8-95370b9b7d5f #5da23e59-bb75-4011-9d90-78b516b8582d #d7d49cdb-1acc-471d-98c7-43d1c7bd5598">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="74a31571-8ab9-4940-a978-de3eb20535fc">
          <bodies>This slice removes allocations from the decomposed structure/cockpit/brakes/status aggregate functions and allocates only new leaves. Existing bootstrap exchanges whose endpoints still reference aggregate ports require coordinated leaf/delegation mapping by the architecture integration repair; they are not silently converted into BOTS or brake-lamp semantics. Native whole-model validation and that shared integration step are required before claiming a valid complete architecture.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="efaa9388-65da-3848-a107-77e481fde237" name="FSAE2027:VP Accommodate and protect the complete driver population verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#74687862-41f0-3fa6-8399-767433093db4 #620884cc-8046-3942-bde7-0f89ab86328f #91ff15ee-d493-3fcb-ae36-987e19448d03 #9fad6479-206c-3067-a582-7f60d1446f84 #0dc8a429-72f3-3496-9ca1-cf02f545968b #7a6f9a04-fcd9-3f93-a8ed-a124a43db2a8 #d11b006a-e552-3296-b73d-7b8c63bb6d13 #3dd54d12-84d9-32d1-8d51-4cd133002f92 #12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="98ea9865-d05d-4382-b81a-e3e7e2716756">
          <bodies>Review an approved anthropometric dataset and every driver/equipment combination. Check reach and occupant geometry and sweep all rollover orientations, including restrained head and hand envelopes.
Conditions/alternatives: All team drivers and the prescribed anthropometric range; no single nominal driver is substituted.
Open choices: Driver dataset, team driver measurements, equipment and adjustable seating/control geometry TBD.
Dependencies outside this bounded interpretation: F.1.13
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="f7af12db-f35b-3f9b-84d8-7e7b80441387" name="FSAE2027:VP Choose and substantiate the primary structure verification NOT_VERIFIED"
          summary="NOT_VERIFIED. Candidate source-grounded verification; construction and evidence remain unresolved."
          constrainedElements="#a38b781a-d3b4-3211-869b-3828344fa293 #4aa2525e-f7cd-38a6-a501-c6687cc41946 #94a3d826-a612-3513-8eb3-df5805639f86 #2904fe19-f7ed-30f3-9664-f8e37fe45fe8 #ed2109e2-36e4-3bfe-ad7d-3586083ae889 #53e89cde-5638-3ca6-9f89-f868f7647f38 #73aa2539-f087-3106-a899-6773dbe53099 #cd5566c8-0d9f-3d3d-aa31-1cd3da537f6c #20c5e3a3-d48e-3dfb-b074-539aa988e34a #d40229d7-2efc-3afd-8d10-df1a12902857 #b74914b4-417f-34ad-b663-6fce440b6925 #a8d2f357-a3f6-38c6-8f8c-f03098647dae #dfc544c7-48fa-3561-a2e6-30ce6007c419 #2ac64ffd-f3f9-352c-b5a9-21ebab8188fa #571541be-6a5f-3daa-81d8-c6aaed41d551 #d326dc8a-b6ce-329b-87d9-7ff7f7576a52 #12629578-443d-30a4-a9c2-31e71f1c7e17 #d9a14132-9034-3765-9c6c-016923b70701 #139b970e-56b1-32b4-8943-84e97cd8c3e9 #582aed6a-15af-3cea-8831-5b49b483e6d0 #fdd8a4ee-1221-3c2e-9f01-f77cd4b8eb21 #7686fe63-7467-33e8-b11a-50ac850703bd #6438221b-cc12-37cb-8690-810b57c08f04 #60d950bb-96be-3a3a-9e40-26cd96e39ef1">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="d12cf653-13b0-416b-9770-18f4f73c9ec8">
          <bodies>Select construction in the structural equivalence submission; enumerate every material and transition joint and substantiate equivalence, fastening, bonding and monocoque attachments under the applicable referenced clauses.
Conditions/alternatives: Tube, monocoque and hybrid alternatives remain unresolved. The source F.5.1.1 and F.3.2.1 references to F.3.4.4 are retained as published; F.3.5 actually contains the aluminum provisions. Seek official clarification rather than silently changing the reference.
Open choices: Chassis type, material grades, laminates, connections and equivalence evidence TBD.
Dependencies outside this bounded interpretation: F.2.2.2, F.4, F.5.4, F.5.5, F.7.8
NOT_VERIFIED: a verification obligation, not an executed test or compliance statement.</bodies>
          <languages>Text</languages>
        </ownedSpecification>
      </ownedConstraints>
