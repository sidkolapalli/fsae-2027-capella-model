      <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
          id="31827f65-2ee5-4b0d-a80e-523a1248fd1e" name="FSAE2027:DD verify DD-12 NOT VERIFIED"
          summary="Review nominal-voltage threshold calculation and hard-braking input. Stimulate just below, at and above the current threshold and half-second boundary. Inject open/short faults on every input and demonstrate opening of the entire installed shutdown path. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Both hard braking and threshold-level tractive current for the persistence trip; any BSPD sensor input open/short for the fault trip. Source: FSAE-2027-V1:EV.8.7.2:p001, FSAE-2027-V1:EV.8.7.2:p002, FSAE-2027-V1:EV.8.7.2:p003, FSAE-2027-V1:EV.8.7.3:p001">
        <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
            id="88e72f0d-c7f8-4c7e-b609-5cc9e4672cfe">
          <bodies>Review nominal-voltage threshold calculation and hard-braking input. Stimulate just below, at and above the current threshold and half-second boundary. Inject open/short faults on every input and demonstrate opening of the entire installed shutdown path. Evidence: unavailable. Status: NOT VERIFIED. Conditions: Both hard braking and threshold-level tractive current for the persistence trip; any BSPD sensor input open/short for the fault trip. Source: FSAE-2027-V1:EV.8.7.2:p001, FSAE-2027-V1:EV.8.7.2:p002, FSAE-2027-V1:EV.8.7.2:p003, FSAE-2027-V1:EV.8.7.3:p001</bodies>
          <languages>Text</languages>
        </ownedSpecification>
