                definition="#a6f8b280-f501-44d6-b974-e0c0e356134b" value="not_available"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="315ff330-6567-4937-9c08-dc00762fc4f2"
                definition="#41afa17f-634c-41e7-979f-4215631eb35d" value="not_claimed"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="86858eea-3558-41ce-ab36-ff69c8750c38"
                definition="#cd92da3c-dabc-4352-8406-10793ad92c60" value="The accelerator pedal operates the APPS. Provide two pedal-return springs; each must return the pedal to zero travel with the other disconnected. Internal APPS springs do not count as the pedal-return springs."/>
