                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#83395866-03f1-3e2e-a2a2-719ca6509efb #2684c6fc-f4c7-3428-b6a0-d935acfcd626">
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="31b61bc6-c9ae-4875-8703-acb42e7bb751">
                        <bodies>TS reaches T.9.1.2 low voltage within 5 s and no protective trip is latched.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="6854a8fe-77d4-30c3-bd7b-9bb766686ef7" name="FSAE2027:SD Protective fault while open"
                      triggerDescription="Independent protective trip" guard="#f175bab9-b09e-3ecb-8d5f-e7bda3a0e8eb"
                      source="#97ecc430-9fab-3093-a9c1-7bcc4f6021ce" target="#38f3a24e-2a98-3c75-88bc-e5ca249da967">
                    <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                        id="f175bab9-b09e-3ecb-8d5f-e7bda3a0e8eb" name="FSAE2027:SD Protective fault while open guard"
                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#83395866-03f1-3e2e-a2a2-719ca6509efb #2684c6fc-f4c7-3428-b6a0-d935acfcd626">
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="f686b0a9-18a6-4e68-8f13-3a9c9d2438dd">
                        <bodies>BMS IMD or BSPD trip detected while disabled or charger-connected; keep coil current and balancing off.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </ownedConstraints>
                  </ownedTransitions>
                  <ownedTransitions xsi:type="org.polarsys.capella.core.data.capellacommon:StateTransition"
                      id="5c9b556c-1844-3314-8915-3a5d112340e2" name="FSAE2027:SD Only local manual reset releases latch"
                      triggerDescription="Permitted local manual reset" guard="#37d432bb-6da5-3629-af85-ac569c5eaeae"
                      source="#38f3a24e-2a98-3c75-88bc-e5ca249da967" target="#97ecc430-9fab-3093-a9c1-7bcc4f6021ce">
