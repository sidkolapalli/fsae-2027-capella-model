          <ownedRequirements xsi:type="Requirements:Requirement" id="62c55810-5923-42de-b367-f405e0d5f9ef"
              ReqIFIdentifier="FSAE2027:DD:DD-10" ReqIFLongName="Latch simultaneous brake and accelerator conflict"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Monitor mechanical-brake engagement together with APPS travel greater than twenty-five percent. When both occur, immediately and completely remove motor power. Keep that inhibit active until APPS travel is below five percent, regardless of brake operation. Demonstrate the complete behavior at technical inspection.">
