                definition="#ca60b341-b6be-489d-a1d0-6e0419f9d48e" value="[{&quot;quantity&quot;:&quot;simultaneous condition persistence&quot;,&quot;value&quot;:0.5,&quot;unit&quot;:&quot;s&quot;,&quot;operator&quot;:&quot;>&quot;},{&quot;quantity&quot;:&quot;power equivalent at nominal battery voltage&quot;,&quot;value&quot;:5,&quot;unit&quot;:&quot;kW&quot;,&quot;role&quot;:&quot;current-threshold reference, not a measured-power comparator&quot;},{&quot;quantity&quot;:&quot;BSPD current threshold&quot;,&quot;expression&quot;:&quot;5000 W / U_nominal&quot;,&quot;role&quot;:&quot;derived relation; U_nominal unresolved&quot;}]"/>
