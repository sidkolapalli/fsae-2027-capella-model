          <ownedRequirements xsi:type="Requirements:Requirement" id="0fb8a907-4747-484a-b7be-bbef0b8dda00"
              ReqIFIdentifier="FSAE2027:DD:DD-05" ReqIFLongName="Detect APPS faults and inhibit motor power"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Treat deviation greater than ten percent pedal travel, sensor failures and wiring failures as APPS implausibility. If implausibility persists longer than one hundred milliseconds, stop all motor power immediately. In an EV, stopping power through the motor controller is sufficient; opening the shutdown circuit is not required by this APPS clause. Analogue open/short faults outside the actual operating range must be detected using pull-up/down circuitry. The example 0.5/4.5 V values are not adopted as universal design thresholds. Proposing a deviation threshold above ten percent requires the stated form justification and approval review.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="564b48f3-84eb-4ee3-8f8a-2820c38da028"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="interpreted"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="fc0ff049-3411-4273-a055-3f3d18f06e6d"
                definition="#7d047b7b-d5c2-4581-a36c-9ea870bbae18" value="allocated"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="40df071b-158f-4708-af99-f31d3bac5f45"
                definition="#28b77914-98e1-4e31-9f99-9f81e58c2b65" value="driver-demand-v1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="7690a500-3ad6-4a8f-80ed-a04938bb5885"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="abb2c414-43d7-4bde-822e-2d72b1975eaa"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="bb8a91a3-2c5a-4681-bad4-f30db3541f7c"
                definition="#1f8ea709-058b-42f3-a74f-b33f60325f8c" value="[&quot;FSAE-2027-V1:T.4.2.4:p001&quot;,&quot;FSAE-2027-V1:T.4.2.5:p001&quot;,&quot;FSAE-2027-V1:T.4.2.5:p002&quot;,&quot;FSAE-2027-V1:T.4.2.9:p001&quot;,&quot;FSAE-2027-V1:T.4.2.10:p001&quot;]"/>
