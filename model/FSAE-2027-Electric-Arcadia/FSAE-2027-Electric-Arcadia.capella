          <ownedRequirements xsi:type="Requirements:Requirement" id="633e55d9-c3d8-45b7-9a49-53ed78452c66"
              ReqIFIdentifier="FSAE2027:VP:obligation:MAIN-HOOP" ReqIFLongName="FSAE2027:VP Provide the continuous steel main hoop and its bracing"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Make the main hoop one uncut continuous closed steel tube of class A, spanning the lowest frame members or monocoque bottom. Above the upper side-impact attachment its side-view inclination is strictly below 10 degrees from vertical; below it, forward inclination is unrestricted but rearward inclination is at most 10 degrees. At the bottom-major-structure attachments, front-view inside spacing is at least 380 mm. Provide left and right straight, unbent closed steel class B braces: forward when the hoop leans forward, rearward when it leans rearward, either direction if vertical. Attach no more than 160 mm below the hoop top, preferably as near its top as possible, at an included angle of at least 30 degrees. Securely integrate braces to carry all hoop loads to the major structure without failure.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="d3d3ca79-0059-40bd-a0ae-04f059894c1c"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="7da9801e-5fda-4c7d-b831-fb7374b49dfc"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="a058c1fd-1341-4572-9149-826ce916944a"
                definition="#2accec6a-53af-443b-ac05-920a9e2f77d8" value="FSAE2027:vehicle-protection-v1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="63e7b1fe-4456-4600-a9e7-3fe61b0b7c0f"
