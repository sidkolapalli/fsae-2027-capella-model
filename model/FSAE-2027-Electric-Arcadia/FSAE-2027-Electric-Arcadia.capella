                <ownedRegions xsi:type="org.polarsys.capella.core.data.capellacommon:Region"
                    id="7372a037-984e-34ce-b20c-00d685ad5f94" name="FSAE2027:SD Shutdown circuit operation"
                    involvedStates="#97ecc430-9fab-3093-a9c1-7bcc4f6021ce #9f8b5c2c-856b-303a-afac-f37d3462384e #1cc62671-9d12-3f1c-81df-096bde72f3f7 #38f3a24e-2a98-3c75-88bc-e5ca249da967 #45f5130a-4c70-3740-b9a2-17779110c2af">
                  <ownedStates xsi:type="org.polarsys.capella.core.data.capellacommon:State"
                      id="97ecc430-9fab-3093-a9c1-7bcc4f6021ce" name="FSAE2027:SD Open">
                    <stateInvariant xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                        id="59209348-b2ee-3236-9cf3-6ecdea13b8ea" name="FSAE2027:SD Open safe outputs INVARIANT"
                        summary="NOT_VERIFIED. Source-grounded candidate design obligation; hardware evidence and dependent decisions remain open."
                        constrainedElements="#2684c6fc-f4c7-3428-b6a0-d935acfcd626 #ed424a1a-06dd-3b55-b45e-297309b89ec1 #fb503a24-9e40-357e-9775-35df71607565 #f89d9ce6-4fe2-3c36-bf4c-58bab5d53486 #af6fcc8d-e512-3818-b4e9-5e325c701748 #007b8063-e20b-325f-bbd7-d09eed7356dd">
                      <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                          id="5f1f7372-9568-476e-8d0d-3309d1e468ec">
                        <bodies>Isolation and precharge coil drive absent; tractive battery current interrupted; no applied motor torque; cell balancing inhibited. Residual TS voltage is discharged to T.9.1.2 low voltage within 5 s after opening. Monitoring remains required while charger-connected.</bodies>
                        <languages>Text</languages>
                      </ownedSpecification>
                    </stateInvariant>
                  </ownedStates>
