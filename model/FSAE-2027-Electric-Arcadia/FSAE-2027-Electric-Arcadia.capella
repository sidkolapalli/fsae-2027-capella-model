          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="946a4986-40e1-4c85-ad2b-9f9181c2c89b"
              ReqIFIdentifier="FSAE2027:VP:obligation:FRONT-OBJECTS" ReqIFLongName="FSAE2027:VP Prevent front intrusion and preserve pedal clearance"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Ahead of the AIP in front view permit only IA, fastener heads and lightweight bodywork/nosecones; rearward nuts are recommended. Front wing/mounts must move entirely aft of the AIP without contacting the front bulkhead in a frontal impact; their attachment locations aft of AIP are recommended and tabs extend at most 25 mm ahead of it. At every pedal travel/adjustment position maintain at least 25 mm clearance to the AIP rear face, all front-bulkhead structure and all noncrushable items in primary structure, including batteries/master cylinders/reservoirs.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="72554da2-361f-4b49-99f9-27c7256a0ee7"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
