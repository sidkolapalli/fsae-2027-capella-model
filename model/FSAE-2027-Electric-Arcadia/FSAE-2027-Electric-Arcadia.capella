          <ownedRequirements xsi:type="Requirements:Requirement" id="727089b5-0bd2-4916-b427-596146818ed6"
              ReqIFIdentifier="FSAE2027:DD:DD-12" ReqIFLongName="BSPD trip on persistent brake/high-power conflict or input fault"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Open the shutdown circuit when hard braking coincides for longer than half a second with tractive current corresponding to five kilowatts delivered to motors at nominal battery voltage. Also open the shutdown circuit for any open or short on a BSPD sensor input. The symbolic current threshold is 5000 W divided by nominal battery voltage; the voltage, hard-braking criterion and actual circuit design remain unresolved. Global trip latching/manual-reset behavior belongs to the separate shutdown slice.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="7c091394-5fba-45c3-8a94-1013bc5ade65"
                definition="#2995bb7e-2ae8-44cc-8109-0e3520ef230d" value="interpreted"/>
