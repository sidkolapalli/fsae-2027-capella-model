          <ownedRequirements xsi:type="Requirements:Requirement" id="b04b1594-85f5-4f8f-a697-87f0de87fccf"
              ReqIFIdentifier="FSAE2027:VP:obligation:FIREWALL" ReqIFLongName="FSAE2027:VP Isolate occupants and harness from fluids, batteries and TS"
              requirementType="#f8e4778c-4fd3-4570-94cf-86b53014d474" ReqIFText="Separate the driver compartment and every harness portion from fuel-system components if present, engine oil if present, liquid cooling and lithium batteries; for EV additionally separate all TS components except the specified outboard wheel motors and their cables at wheels/front arms. Extend the firewall so no body point less than 100 mm above the tallest driver's helmet bottom has direct sight to those hazards. Use a tightly mounted rigid nonflammable impermeable surface. For EV/lithium batteries, the battery/TS-side firewall layer is aluminum (not aluminum tape) and grounded per EV.7.7; the tractive battery container cannot serve as firewall. Seal the whole surface, edges, joints, passthroughs and floor against fluids; overlap/seal multi-panel joints, keep inter-firewall sealing unstressed, use passthrough grommets and environmentally rated sealants/adhesives.">
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="c0226679-d9e5-47f3-bf0c-bc64530efdc5"
                definition="#f28516c8-9d0f-4e03-b0f2-cefc6667b433" value="FSAE-2027-V1"/>
            <ownedAttributes xsi:type="Requirements:StringValueAttribute" id="a09a167e-ddbd-4575-91ab-873c79ef9c2b"
                definition="#24357558-2768-408a-b07d-be62178d9e15" value="f71df5552e341dab1b58f1ff47212e7281953d66b9c41833de8347560913ed0e"/>
